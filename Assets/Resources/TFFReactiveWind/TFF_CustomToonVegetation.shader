				float2 temp_output_61_0 = ( appendResult60 * 0.1 );
				float2 panner63 = ( (  (0.0 + ( _WindScroll - 0.0 ) * ( 0.3 - 0.0 ) / ( 1.0 - 0.0 ) ) * (_TimeParameters.x + _FlightWindOffset) ) * float2( 1,1 ) + temp_output_61_0);
				float4 saferPower72 = abs( tex2Dlod( _WindNoiseTexture, float4( panner63, 0, 0.0) ) );
				float2 panner74 = ( ( (_TimeParameters.x + _FlightWindOffset) *  (0.0 + ( _WindJitter - 0.0 ) * ( 0.5 - 0.0 ) / ( 1.0 - 0.0 ) ) ) * float2( 1,1 ) + ( temp_output_61_0 * float2( 2,2 ) ));
				float4 WindScroll68 = ( ( pow( saferPower72 , 2.5 ) * tex2Dlod( _WindNoiseTexture, float4( panner74, 0, 0.0) ) ) * input.ase_color );
				
				float3 ase_normalWS = TransformObjectToWorldNormal( input.normalOS );
				OUTPUT_LIGHTMAP_UV( input.texcoord1, unity_LightmapST, output.lightmapUVOrVertexSH.xy );
				OUTPUT_SH( ase_normalWS, output.lightmapUVOrVertexSH.xyz );
				#if defined( DYNAMICLIGHTMAP_ON )
