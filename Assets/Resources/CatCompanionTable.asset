      \uBC29\uC5D0 \uCC38\uAC00\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4\uC639."
    - "\uBC29 \uC785\uC7A5\uC740 \uB2E4\uB978 \uC0AC\uB78C\uC774 \uB9CC\uB4E0 \uBC29\uC5D0
      \uAC00\uB294 \uAC70\uB2E4\uC639. \n\uC774 \uBAB8\uC774 \uC624\uBA74 \uB2E4\uB4E4
      \uAE30\uBED0\uD558\uACA0\uC9C0\uB0E5?"
  - id: return
    highlight: 8
    waitForTargetClick: 1
    practice: 0
    animation: 3
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB4A4\uB85C\uAC00\uAE30\uB97C \uB20C\uB7EC\uB77C\uB0E5! \uB4A4\uB3CC\uC544\uC11C
      \uB204\uB97C \uD544\uC694\uB294 \uC5C6\uB354\uB77C\uC639!"
    - "\uB4A4\uB85C\uAC00\uAE30\uB97C \uB20C\uB7EC \uB3CC\uC544\uAC00\uC790\uB0E5.
      \uC124\uBA85\uD588\uB354\uB2C8 \uC2AC\uC2AC \uCD9C\uCD9C\uD558\uB2E4\uC639."
    - "\uC124\uBA85\uC740 \uB4E4\uC5C8\uC9C0\uC639? \uB4A4\uB85C\uAC00\uAE30\uB97C
      \uB20C\uB7EC\uB77C\uB0E5."
    - "\uB4A4\uB85C\uAC00\uAE30\uB97C \uB20C\uB7EC\uB77C\uB0E5\u2026 \uC6B0\uB9AC
      \uC5B4\uB514\uC11C \uC654\uB354\uB77C\uC639\u2026"
    - "\uB4A4\uB85C\uAC00\uAE30\uB97C \uB20C\uB7EC \uB3CC\uC544\uAC00\uC790\uB0E5.
      \uC798 \uB530\uB77C\uC640 \uC918\uC11C \uC88B\uB2E4\uC639. \uB2E4\uC74C\uB3C4
      \uAC19\uC774 \uBCF4\uC790\uB0E5."
    - "\uBAA8\uB4DC \uC548\uB0B4\uB97C \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4\uC639. \uB4A4\uB85C\uAC00\uAE30
      \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB3CC\uC544\uAC00\uC2DC\uC9C0\uC694."
    - "\uB4A4\uB85C\uAC00\uAE30\uB97C \uB204\uB974\uB77C\uC639. \uC548\uB0B4\uAC00
      \uD6CC\uB96D\uD588\uC73C\uBA74 \uC774 \uBAB8\uC744 \uCE6D\uCC2C\uD574\uB3C4
      \uC88B\uB2E4\uB0E5!"
  - id: welcome
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 11
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC900\uBE44\uB410\uC73C\uBA74 \uC6D0\uD558\uB294 \uBAA8\uB4DC\uB97C \uC2DC\uC791\uD574\uB77C\uB0E5!
      \uC751\uC6D0\uC740 \uB0B4\uAC00 \uB9E1\uB294\uB2E4\uC639!"
    - "\uC900\uBE44\uB410\uC73C\uBA74 \uC6D0\uD558\uB294 \uBAA8\uB4DC\uB85C \uAC00\uB77C\uB0E5.
      \uB09C \uB4E0\uB4E0\uD558\uAC8C \uBA39\uACE0 \uC751\uC6D0\uD558\uACA0\uB2E4\uC639."
    - "\uC900\uBE44\uB410\uC73C\uBA74 \uC6D0\uD558\uB294 \uBAA8\uB4DC\uB85C \uAC00\uB77C\uC639.
      \uB05D\uB098\uBA74\u2026 \uBB34\uC0AC\uD788 \uB3CC\uC544\uC624\uACE0\uB0E5."
    - "\uC6D0\uD558\uB294 \uBAA8\uB4DC\uC5D0\uC11C \uC2DC\uC791\uD574\uB77C\uB0E5\u2026
      \uB09C \uC548 \uC794\uB2E4\uC639\u2026 \uB208\uB9CC \uC26C\uB294 \uAC70\uB2E4\uB0E5\u2026"
    - "\uC6D0\uD558\uB294 \uBAA8\uB4DC\uC5D0\uC11C \uC2DC\uC791\uD574\uB77C\uB0E5.
      \uC798\uD574\uB3C4 \uBABB\uD574\uB3C4 \uB3CC\uC544\uC624\uBA74 \uAF2D \uBC18\uACA8
      \uC904\uAC8C\uC639."
    - "\uC900\uBE44\uB418\uC168\uB2E4\uBA74 \uC6D0\uD558\uC2DC\uB294 \uBAA8\uB4DC\uB85C
      \uCD9C\uBC1C\uD558\uC2DC\uC9C0\uC694\uC639. \uACC1\uC5D0\uC11C \uB3D5\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uC900\uBE44\uB410\uB2E4\uBA74 \uC6D0\uD558\uB294 \uBB34\uB300\uB85C \uB098\uAC00\uB77C\uC639!
      \uB2F9\uB2F9\uD558\uAC8C \uC2F8\uC6B0\uB77C\uB0E5."
  - id: stay_together
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 10
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC124\uBA85 \uB05D\uC774\uB2E4\uB0E5! \n\uB098\uB3C4 \uC4F0\uB2E4\uB4EC\uC5B4\uB77C\uC639.
      \n\uB098\uB97C \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C! \u2026\uB0B4\uAC00
      \uB124 \uC190\uC744 \uC4F0\uB2E4\uB4EC\uB294 \uAC74\uAC00\uB0E5?"
    - "\uCA5D\uCA5D\u2026 \uB098\uB97C \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C
      \uC4F0\uB2E4\uB4EC\uC5B4\uB77C\uB0E5. \n\uBC30\uB3C4 \uC0B4\uC0B4~ \uAC04\uC2DD\uAE4C\uC9C0
      \uC8FC\uBA74 \uB354 \uC88B\uACE0\uC639."
    - "\uB098\uB97C \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C \uC4F0\uB2E4\uB4EC\uC5B4\uB3C4
      \uB41C\uB2E4\uC639. \n\uB124 \uC190\uC774 \uC2EC\uC2EC\uD560\uAE4C \uBD10\uB2E4\uB0E5!
      \u2026\uBC8C\uC368 \uADF8\uB9CC\uC774\uB0D0\uC639?"
    - "\uB098\uB97C \uAFB9 \uB204\uB974\uACE0 \uC704\uC544\uB798\uB85C \uC4F0\uB2E4\uB4EC\uC5B4\uB77C\uB0E5\u2026
      \n\uAE68\uC6CC \uB2EC\uB7AC\uB294\uB370\u2026 \uB354 \uC878\uB9AC\uB124\uC639\u2026
      \uB4DC\uB974\uB801\u2026"
    - "\uB098\uB3C4 \uC4F0\uB2F4\uC4F0\uB2F4\uD574 \uC918\uB0E5. \n\uB098\uB97C \uB204\uB978
      \uCC44 \uC704\uC544\uB798\uB85C \uC0B4\uC0B4 \uC6C0\uC9C1\uC5EC \uC918\uC639.
      \n\uB124 \uC190\uC774\uBA74 \uACC4\uC18D \uBC1B\uACE0 \uC2F6\uB2E4\uB0E5."
    - "\uAD1C\uCC2E\uC73C\uC2DC\uB2E4\uBA74 \uC800\uB97C \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C
      \uC4F0\uB2E4\uB4EC\uC5B4 \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C\uC639? \n\uC548\uB0B4\uC758
      \uBCF4\uB2F5\uC740 \uADF8\uAC78\uB85C \uCDA9\uBD84\uD569\uB2C8\uB2E4."
    - "\uD2B9\uBCC4\uD788 \uC4F0\uB2E4\uB4EC\uB294 \uAC78 \uD5C8\uB77D\uD558\uACA0\uB2E4\uC639!
      \n\uB098\uB97C \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C \uC815\uC131\uAECF\u2026
      \uBA48\uCD94\uB77C\uB294 \uB9D0\uC740 \uC548 \uD588\uB2E4\uB0E5!"
  trainingTutorial:
  - id: flag
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uC544\uAD70\uACFC \uAE43\uBC1C\uC744 \uBE7C\uC557\uC544 \uC9C0\uCF1C\uB77C\uB0E5!
      \n\uB05D\uB098\uBA74 \uAE43\uBC1C\uC744 \uAC00\uC9C4 \uD300\uC774 \uC2B9\uB9AC\uB2E4\uB0E5!"
    - "\uC544\uAD70\uACFC \uAE43\uBC1C\uC744 \uBE7C\uC557\uC544 \uC9C0\uCF1C\uB77C\uB0E5.
      \n\uB0B4 \uAC04\uC2DD \uC9C0\uD0A4\uB4EF \uAF2D \uBD99\uC5B4 \uC788\uC5B4\uB77C\uC639."
    - "\uC544\uAD70\uACFC \uAE43\uBC1C\uC744 \uBE7C\uC557\uC544 \uC9C0\uCF1C\uB77C\uC639.
      \n\uD63C\uC790 \uC704\uD5D8\uD55C \uB370 \uAC00\uC9C0 \uB9D0\uACE0\uB0E5."
    - "\uC544\uAD70\uACFC \uAE43\uBC1C\uC744 \uBE7C\uC557\uC544 \uC9C0\uD0A4\uBA74
      \uC774\uAE34\uB2E4\uB0E5\u2026\n\uC774\uBD88\uB85C \uC4F0\uB294 \uAC74 \uC544\uB2C8\uACE0\uC639\u2026"
    - "\uC544\uAD70\uACFC \uAE43\uBC1C\uC744 \uBE7C\uC557\uC544 \uC9C0\uCF1C\uB77C\uB0E5.
      \n\uD63C\uC790 \uBA40\uB9AC \uAC00\uC9C0 \uB9D0\uACE0 \uAF2D \uBD99\uC5B4 \uC788\uC5B4\uB77C\uC639."
    - "\uC544\uAD70\uACFC \uAE43\uBC1C\uC744 \uBE7C\uC557\uC544 \uC9C0\uD0A4\uB294
      \uAC83\uC774 \uBAA9\uD45C\uC785\uB2C8\uB2E4\uC639. \n\uC11C\uB85C\uB97C \uC9C0\uCF1C
      \uC8FC\uC2ED\uC2DC\uC624."
    - "\uAE43\uBC1C\uC744 \uBE7C\uC557\uC544 \uC624\uB798 \uC9C0\uCF1C\uB77C\uC639!
      \n\uC544\uAD70\uACFC \uD568\uAED8 \uC2B9\uB9AC\uB97C \uCC28\uC9C0\uD558\uB77C\uB0E5."
  - id: automatic_flight
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 4
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uC548 \uB20C\uB800\uB294\uB370 \uC55E\uC73C\uB85C \uAC04\uB2E4\uB0E5! \n\uACE0\uC7A5\uC740
      \uC544\uB2C8\uB2E4\uC639. \n\uB9C8\uC6B0\uC2A4\uB85C \uBC29\uD5A5\uC744 \uBC14\uAFD4\uB77C\uB0E5."
    - "\uC790\uB3D9\uC73C\uB85C \uC804\uC9C4\uD558\uB2C8 \uD3B8\uD558\uB2E4\uB0E5.
      \n\uB9C8\uC6B0\uC2A4\uB85C \uBC29\uD5A5\uB9CC \uC798 \uC7A1\uC544\uB77C\uC639."
    - "\uAE30\uBCF8\uC740 \uC790\uB3D9 \uC804\uC9C4\uC774\uB2E4\uC639. \n\uB9C8\uC6B0\uC2A4\uB85C
      \uBC29\uD5A5\uC774\uB098 \uC798 \uBD10\uB77C\uB0E5."
    - "\uC790\uB3D9\uC73C\uB85C \uC55E\uC73C\uB85C \uAC04\uB2E4\uB0E5\u2026\n \uB0B4\uAC00
      \uBC00\uC5C8\uB098\uC639?\n \uBC29\uD5A5\uC740 \uB9C8\uC6B0\uC2A4\uB85C \uBC14\uAFD4\uB77C\uB0E5\u2026"
    - "\uC790\uB3D9\uC73C\uB85C \uC55E\uC73C\uB85C \uAC04\uB2E4\uB0E5. \n\uB9C8\uC6B0\uC2A4\uB85C
      \uBC29\uD5A5\uC744 \uBC14\uAFD4\uB77C\uC639. \n\uB098\uB3C4 \uB124 \uACC1\uC5D0
      \uAF2D \uBD99\uC5B4 \uAC04\uB2E4\uB0E5."
    - "\uC790\uB3D9\uC73C\uB85C \uC804\uC9C4\uD569\uB2C8\uB2E4\uC639.\n\uB9C8\uC6B0\uC2A4\uB85C
      \uC9C4\uD589 \uBC29\uD5A5\uC744 \uC870\uC808\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    - "\uC790\uB3D9\uC73C\uB85C \uC804\uC9C4\uD558\uB2C8 \uB9C8\uC6B0\uC2A4\uB85C
      \uBC29\uD5A5\uC744 \uC7A1\uC73C\uB77C\uC639! \n\uC6B0\uC544\uD558\uAC8C \uB0A0\uC544
      \uAC00\uBCF4\uB77C\uB0E5~!!!"
