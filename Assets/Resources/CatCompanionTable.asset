    animation: 8
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uC801\uC744 \uBCF4\uACE0 {aim}\uB97C \uB204\uB974\uB77C\uB0E5. \n\uCD08\uB85D
      \uC870\uC900\uC810\uC774\uBA74 \uB193\uC544 \uC3F4\uB77C\uC639! \n\uCEA3\uB2D9\uC0C9
      \uB9D0\uC774\uB2E4\uB0E5"
    - "\uC801\uC744 \uBCF4\uACE0 {aim}\uB97C \uB204\uB974\uB77C\uB0E5. \n\uCD08\uB85D\uC0C9\uC73C\uB85C
      \uBCC0\uD558\uBA74 \uB193\uC544 \uC3F4\uB77C\uC639. \n\uC775\uC744 \uB54C\uAE4C\uC9C0
      \uAE30\uB2E4\uB9AC\uB4EF\uB0E5."
    - "\uC801\uC744 \uBCF4\uBA70 {aim}\uB97C \uB20C\uB7EC\uB77C\uC639. \n\uC870\uC900\uC810\uC774
      \uCD08\uB85D\uC0C9\uC774 \uB418\uBA74 \uB193\uC544 \uC3F4\uB77C\uB0E5."
    - "\uC801\uC744 \uBCF4\uACE0 {aim}\uB97C \uB204\uB974\uB77C\uB0E5\u2026\n\uCD08\uB85D
      \uC870\uC900\uC810\uC774\uBA74 \uB193\uC544 \uBC1C\uC0AC\u2026\n\uCEA3\uB2D9
      \uAC19\uB2E4\uC639\u2026"
    - "\uC801\uC744 \uBCF4\uBA70 {aim}\uB97C \uB204\uB974\uACE0, \uCD08\uB85D \uC870\uC900\uC810\uC774
      \uB418\uBA74 \uB193\uC544 \uC3F4\uB77C\uB0E5.\n\uC131\uACF5\uD558\uBA74 \uB098\uBD80\uD130
      \uBD10\uB77C\uC639!"
    - "\uC801\uC744 \uBCF4\uBA70 {aim}\uB97C \uC720\uC9C0\uD558\uC2ED\uC2DC\uC639.
      \n\uC870\uC900\uC810\uC774 \uCD08\uB85D\uC0C9\uC774 \uB418\uBA74 \uB193\uC544
      \uBC1C\uC0AC\uD574 \uBCF4\uC2DC\uC9C0\uC694."
    - "\uC801\uC744 \uBCF4\uBA70 {aim}\uB97C \uB204\uB974\uB77C\uC639! \n\uCD08\uB85D\uC0C9\uC73C\uB85C
      \uBCC0\uD558\uBA74 \uB193\uC544 \uBA85\uC911\uC2DC\uCF1C\uB77C\uB0E5."
  - id: release
