      \uADF8\uB807\uB124\uC639\u2026"
    - "\uBCBD\uC5D0 \uBE60\uB974\uAC8C \uBD80\uB52A\uD788\uBA74 \uB2E4\uCE5C\uB2E4\uB0E5.
      \n\uB124\uAC00 \uC544\uD504\uBA74 \uB098\uB3C4 \uC18D\uC0C1\uD558\uB2E4\uC639.
      \uBCBD \uAC00\uAE4C\uC774\uB294 \uC870\uC2EC\uD574\uB77C\uB0E5."
    - "\uBCBD\uC5D0 \uBE60\uB974\uAC8C \uBD80\uB52A\uD788\uBA74 \uB2E4\uCE58\uC2ED\uB2C8\uB2E4\uC639.
      \n\uBD80\uB514 \uC548\uC804\uAC70\uB9AC\uB97C \uC9C0\uCF1C \uC8FC\uC2ED\uC2DC\uC624."
    - "\uBCBD\uC5D0 \uBE60\uB974\uAC8C \uBD80\uB52A\uD788\uBA74 \uB2E4\uCE5C\uB2E4\uC639!
      \n\uC774 \uBAB8\uC758 \uD138\uAE4C\uC9C0 \uD5DD\uD074\uC5B4\uC9C0\uBA74 \uACE4\uB780\uD558\uB2C8
      \uC870\uC2EC\uD558\uB77C\uB0E5."
  - id: practice
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 11
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uC790\uC720\uB86D\uAC8C \uC5F0\uC2B5\uD574\uB77C\uB0E5! \uC124\uBA85 \uB2E4
      \uD588\uB2E4\uC639! \u2026\uB0B4 \uC774\uB984\uC740 \uC124\uBA85\uD588\uB098?"
    - "\uC790\uC720\uB86D\uAC8C \uC5F0\uC2B5\uD574\uB77C\uB0E5. \uB09C \uAC04\uC2DD
      \uBA39\uC73C\uBA70 \uBD10 \uC8FC\uACA0\uB2E4\uC639. \uCA5D\uCA5D\u2026 \uB124
      \uBAAB\uC740 \uB530\uB85C \uC788\uB098\uB0E5?"
    - "\uC790\uC720\uB86D\uAC8C \uC5F0\uC2B5\uD574\uB77C\uC639. \uC548 \uB418\uBA74
      \uC606\uC5D0\uC11C\u2026 \uD55C \uBC88\uB9CC \uB354 \uBD10 \uC904\uAC8C\uB0E5."
    - "\uC790\uC720\uB86D\uAC8C \uC5F0\uC2B5\uD574\uB77C\uB0E5\u2026 \uC124\uBA85
      \uB05D\uB0AC\uC9C0\uC639? \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uD560 \uBED4\uD588\uB124\uB0E5\u2026"
    - "\uC790\uC720\uB86D\uAC8C \uC5F0\uC2B5\uD574\uB77C\uB0E5. \uC131\uACF5\uD558\uBA74
      \uB098\uBD80\uD130 \uBD10 \uC918\uC639! \uAC19\uC774 \uAE30\uBED0\uD558\uACE0
      \uC2F6\uB2E4\uB0E5."
    - "\uC548\uB0B4\uB97C \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4\uC639. \uD3B8\uD788 \uC5F0\uC2B5\uD558\uC2ED\uC2DC\uC624.
      \uD544\uC694\uD558\uC2DC\uBA74 \uACC1\uC5D0\uC11C \uB3D5\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uC790\uC720\uB86D\uAC8C \uC5F0\uC2B5\uD558\uB77C\uC639! \uC798\uD558\uBA74
      \uC774 \uBAB8\uC774 \uC9C1\uC811 \uCE6D\uCC2C\uD574 \uC8FC\uACA0\uB2E4\uB0E5."
