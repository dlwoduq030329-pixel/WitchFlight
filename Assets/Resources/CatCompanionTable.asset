  tutorial:
  - id: greeting
    highlight: 0
    waitForTargetClick: 0
    animation: 3
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC0C8\uB85C\uC6B4 \uC9D1\uC0AC\u2026 \uC5B4? \uB9C8\uB140\uC600\uB0E5? \uC544\uBB34\uD2BC
      \uBC18\uAC11\uB2E4\uC639~"
    - "\uC0C8\uB85C\uC6B4 \uC9D1\uC0AC\u2026 \uC544\uB2C8, \uB9C8\uB140\uAC00 \uC654\uAD6C\uB098\uB0E5~
      \uD658\uC601\uD55C\uB2E4\uB0E5!"
    - "\uC0C8\uB85C\uC6B4 \uB9C8\uB140\uB124. \uB531\uD788 \uAE30\uB2E4\uB9B0 \uAC74
      \uC544\uB2C8\uB2E4\uC639\u2026 \uB4E4\uC5B4\uC624\uB77C\uB0E5."
    - "\uC0C8\uB85C\uC6B4\u2026 \uB204\uAD6C\uC600\uC9C0\uB0E5\u2026 \uC544, \uB9C8\uB140\uB2E4\uC639.
      \uC798 \uC654\uB2E4\uB0E5~"
    - "\uC0C8\uB85C\uC6B4 \uC9D1\uC0AC\u2026 \uC544\uB2C8 \uB9C8\uB140\uB2E4\uB0E5!
      \uBC18\uAC11\uB2E4\uB0E5, \uB0E5\uB0E5~"
    - "\uC0C8\uB85C \uC624\uC2E0 \uB9C8\uB140\uB2D8\uC774\uC2DC\uAD70\uC694. \uB9C8\uBC95
      \uD559\uAD50\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD55C\uB2E4\uB0E5."
    - "\uC0C8\uB85C\uC6B4 \uB9C8\uB140\uB85C\uAD6C\uB098\uB0E5! \uC774 \uBAB8\uC744
      \uB9CC\uB098\uB2E4\uB2C8 \uC6B4\uC774 \uC88B\uB2E4\uC639~"
  - id: introduction
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 1.3
    personalityLines:
    - "\uB108\uC5D0\uAC8C \uBC30\uC815\uB41C \uC120\uBC30 \uB9C8\uB140\uB2E4\uC639!
      \uAE38\uC740\u2026 \uC544\uB9C8 \uC54C\uACE0 \uC788\uB2E4\uB0E5!"
    - "\uB098\uB294 \uB108\uC5D0\uAC8C \uBC30\uC815\uB41C \uC120\uBC30 \uB9C8\uB140\uB2E4\uC639.
      \uCC28\uADFC\uCC28\uADFC \uB3C4\uC640\uC8FC\uACA0\uB2E4\uB0E5~"
    - "\uB124 \uC548\uB0B4\uB97C \uB9E1\uC740 \uC120\uBC30 \uB9C8\uB140\uB2E4\uC639.
      \uD5E4\uB9E4\uBA74 \uACE4\uB780\uD558\uB2C8\uAE4C \uC54C\uB824\uC8FC\uB294
      \uAC70\uB2E4\uB0E5."
    - "\uB09C \uB124 \uC120\uBC30\u2026 \uBA00\uB140\u2026 \uB9C8\uB140\uB2E4\uC639.
      \uC7A0\uAE50 \uB534\uC0DD\uAC01\uD588\uB2E4\uB0E5."
    - "\uB108\uB9CC\uC758 \uC120\uBC30 \uB9C8\uB140\uB2E4\uC639~ \uC6B0\uB9AC \uAE08\uBC29
      \uCE5C\uD574\uC9C8 \uAC83 \uAC19\uB2E4\uB0E5!"
    - "\uC800\uB294 \uB9C8\uB140\uB2D8\uC758 \uC548\uB0B4\uB97C \uB9E1\uC740 \uC120\uBC30
      \uB9C8\uB140\uB2E4\uC639. \uC798 \uBD80\uD0C1\uB4DC\uB9B0\uB2E4\uB0E5."
    - "\uB108\uC5D0\uAC8C \uBC30\uC815\uB41C \uC120\uBC30 \uB9C8\uB140, \uBC14\uB85C
      \uC774 \uBAB8\uC774\uB2E4\uC639! \uC601\uAD11\uC73C\uB85C \uC54C\uB77C\uB0E5~"
  - id: wardrobe
    highlight: 1
    waitForTargetClick: 1
    animation: 3
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC800 \uC637\uC7A5\uC73C\uB85C \uAC00\uB77C\uB0E5! \uBCF4\uB2F5\uC740 \uCE04\uB974\u2026
      \uB450 \uAC1C\uC600\uB098\uB0E5? \uC637\uC7A5\uC744 \uB20C\uB7EC\uBCF4\uB77C\uB0E5~"
    - "\uB530\uB77C\uC624\uB77C\uB0E5! \uBE5B\uB098\uB294 \uC637\uC7A5\uC744 \uB20C\uB7EC\uBCF4\uB77C\uB0E5.
      \uBCF4\uB2F5\uC740 \uCE04\uB974\uB85C \uBC1B\uACA0\uB2E4\uB0E5~"
    - "\uC637\uC7A5\uBD80\uD130 \uB20C\uB7EC\uBCF4\uB77C\uB0E5. \uC548\uB0B4\uBE44\uB294
      \uCE04\uB974\uBA74 \uCDA9\uBD84\uD558\uB2E4\uC639\u2026 \uD2B9\uBCC4\uD788
      \uBD10\uC8FC\uB294 \uAC70\uB2E4\uB0E5."
    - "\uB530\uB77C\uC624\uB77C\uB0E5\u2026 \uCE04\uB974 \uC0DD\uAC01\uC740 \uB098\uC911\uC5D0
      \uD558\uACE0. \uBE5B\uB098\uB294 \uC637\uC7A5\uC744 \uB204\uB974\uB77C\uB0E5."
    - "\uBC18\uC9DD\uBC18\uC9DD \uC637\uC7A5\uC744 \uCF55 \uB20C\uB7EC\uBCF4\uB77C\uB0E5~
      \uBCF4\uB2F5\uC740 \uCE04\uB974\uB791 \uC4F0\uB2F4\uC4F0\uB2F4\uC774\uB2E4\uB0E5~"
    - "\uBA3C\uC800 \uD45C\uC2DC\uB41C \uC637\uC7A5\uC744 \uB20C\uB7EC\uC8FC\uC2DC\uACA0\uB0E5?
      \uC0AC\uB840\uB294 \uCE04\uB974 \uD55C \uAC1C\uBA74 \uCDA9\uBD84\uD558\uB2E4\uC639."
    - "\uC774 \uBAB8\uC744 \uB530\uB77C \uC637\uC7A5\uC744 \uC5F4\uC5B4\uBCF4\uB77C\uB0E5!
      \uBCF4\uB2F5\uC73C\uB85C \uCD5C\uACE0\uAE09 \uCE04\uB974\uB97C \uC900\uBE44\uD558\uB77C\uC639~"
  - id: dorm
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC5EC\uAE30\uAC00 \uB124 \uAE30\uC219\uC0AC\uB2E4\uB0E5! \uCE68\uB300\uB294\u2026
      \uC637\uC7A5 \uC548\uC5D0 \uC5C6\uACA0\uC9C0\uB0E5?"
    - "\uC774\uACF3\uC740 \uB108\uC758 \uAE30\uC219\uC0AC\uB2E4\uB0E5~ \uD3B8\uD558\uAC8C
      \uC26C\uACE0 \uAFB8\uBBF8\uB294 \uACF3\uC774\uB2E4\uC639."
    - "\uB124 \uAE30\uC219\uC0AC\uB2E4\uB0E5. \uC815\uB9AC\uB294 \uC2A4\uC2A4\uB85C
      \uD558\uB77C\uC639\u2026 \uD544\uC694\uD558\uBA74 \uC870\uAE08\uC740 \uB3C4\uC640\uC8FC\uACA0\uB2E4\uB0E5."
    - "\uC774\uACF3\uC740 \uB108\uC758 \uAE30\uC219\uC0AC\u2026 \uD587\uBCD5\uC774
      \uC88B\uC544\uC11C \uC7A0\uC774 \uC628\uB2E4\uC639\u2026"
    - "\uC5EC\uAE30\uAC00 \uB124 \uAE30\uC219\uC0AC\uB2E4\uB0E5~ \uC544\uB291\uD558\uB2E4\uC639,
      \uB098\uB3C4 \uC5EC\uAE30\uC11C \uC0B4\uACE0\uC2F6\uB2E4\uC639!"
    - "\uC774\uACF3\uC774 \uB9C8\uB140\uB2D8\uC758 \uAE30\uC219\uC0AC\uB2E4\uC639.
      \uD3B8\uC548\uD558\uAC8C \uC774\uC6A9\uD558\uC2DC\uB77C\uB0E5."
    - "\uB124 \uAE30\uC219\uC0AC\uB2E4\uB0E5. \uC774 \uBAB8\uC758 \uAD81\uC804\uB9CC\uD07C\uC740
      \uC544\uB2C8\uC9C0\uB9CC \uC81C\uBC95\uC774\uB2E4\uC639~"
  - id: free_style
    highlight: 0
    waitForTargetClick: 0
    animation: 9
    dreamyPauseSeconds: 1.5
    personalityLines:
    - "\uC637\uC774\uB791 \uBBF8\uC6A9\uC2E4\uC740 \uACF5\uC9DC\uB2E4\uB0E5! \uACF5\uC9DC\uBA74
      \uCE04\uB974\uB3C4\u2026 \uC544, \uADF8\uAC74 \uC544\uB2C8\uB2E4\uC639."
    - "\uB9C8\uB140\uB4E4\uC5D0\uAC8C \uC758\uC0C1\uACFC \uBBF8\uC6A9\uC2E4\uC740
      \uACF5\uC9DC\uB2E4\uC639. \uBD80\uB2F4 \uC5C6\uC774 \uB9C8\uC74C\uAECF \uAFB8\uBA70\uBCF4\uB77C\uB0E5~"
    - "\uC758\uC0C1\uACFC \uBBF8\uC6A9\uC2E4\uC740 \uACF5\uC9DC\uB2E4\uC639. \uB124\uAC00
      \uC798 \uC5B4\uC6B8\uB9AC\uAC8C \uAFB8\uBBF8\uB4E0 \uB9D0\uB4E0\u2026 \uAE30\uB300\uB294
      \uC548 \uD55C\uB2E4\uB0E5."
    - "\uC758\uC0C1\uACFC \uBBF8\uC6A9\uC2E4\uC740\u2026 \uC74C\u2026 \uB9DE\uB2E4,
      \uACF5\uC9DC\uB2E4\uC639. \uB9C8\uC74C\uAECF \uAFB8\uBA70\uBCF4\uB77C\uB0E5."
    - "\uC637\uB3C4 \uBA38\uB9AC\uB3C4 \uB9C8\uC74C\uAECF \uAFB8\uBA70\uBCF4\uB77C\uB0E5!
      \uC804\uBD80 \uACF5\uC9DC\uB77C\uB2C8 \uC2E0\uB09C\uB2E4\uC639~"
    - "\uC758\uC0C1\uACFC \uBBF8\uC6A9\uC2E4\uC740 \uBB34\uB8CC\uB85C \uC81C\uACF5\uB41C\uB2E4\uC639.
      \uCDE8\uD5A5\uC5D0 \uB9DE\uAC8C \uCC9C\uCC9C\uD788 \uACE8\uB77C\uBCF4\uC2DC\uB77C\uB0E5."
    - "\uC758\uC0C1\uACFC \uBBF8\uC6A9\uC2E4\uC740 \uACF5\uC9DC\uB2E4\uC639! \uC774
      \uBAB8 \uACC1\uC5D0 \uC124 \uD14C\uB2C8 \uBA4B\uC9C0\uAC8C \uAFB8\uBA70\uBCF4\uB77C\uB0E5~"
  - id: weapon_tab
    highlight: 2
    waitForTargetClick: 1
    animation: 3
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uBA4B\uC788\uC5B4\uC84C\uC73C\uBA74 \uC704\uCABD \uBB34\uAE30 \uD0ED\uC744
      \uB20C\uB7EC\uBCF4\uB77C\uB0E5. \uBE57\uC740 \uBB34\uAE30\uAC00 \uC544\uB2C8\uC5C8\uB0E5\u2026?"
    - "\uAFB8\uBBF8\uAE30\uB294 \uC5B8\uC81C\uB4E0 \uB2E4\uC2DC \uD560 \uC218 \uC788\uB2E4\uB0E5.
      \uC774\uBC88\uC5D4 \uC704\uCABD \uBB34\uAE30 \uD0ED\uC744 \uB20C\uB7EC\uBCF4\uB77C\uB0E5~"
    - "\uAFB8\uBBF8\uAE30\uB294 \uB098\uC911\uC5D0\uB3C4 \uD560 \uC218 \uC788\uB2E4\uC639.
      \uC774\uC81C \uC704\uCABD \uBB34\uAE30 \uD0ED\uC744 \uB20C\uB7EC\uB77C\uB0E5."
    - "\uC704\uCABD\u2026 \uC5B4\uB290 \uCABD\uC774\uC5C8\uC9C0\u2026 \uC544, \uBC18\uC9DD\uC774\uB294
      \uBB34\uAE30 \uD0ED\uC744 \uB20C\uB7EC\uBCF4\uB77C\uB0E5."
    - "\uC774\uBC88\uC5D4 \uC704\uCABD \uBB34\uAE30 \uD0ED\uC744 \uCF55! \uBA4B\uC9C4
      \uC9C0\uD321\uC774\uB97C \uAD6C\uACBD\uD558\uC790\uB0E5~\u2661"
    - "\uC774\uC81C \uC0C1\uB2E8\uC758 \uBB34\uAE30 \uD0ED\uC744 \uC120\uD0DD\uD574\uC8FC\uC2DC\uACA0\uB0E5?"
    - "\uAFB8\uBBF8\uAE30\uB294 \uADF8\uB9CC\uD558\uACE0 \uC774\uBAB8\uC744 \uBCF4\uB77C\uC639!!
      \uC774\uC81C \uC704\uCABD \uBB34\uAE30 \uD0ED\uC744 \uC5F4\uC5B4\uBCF4\uB77C\uB0E5!"
  - id: wands
    highlight: 0
    waitForTargetClick: 0
    animation: 3
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB2E4\uC591\uD55C \uB9C8\uBC95 \uC9C0\uD321\uC774\uAC00 \uC788\uB2E4\uC639!
      \uC804\uBD80 \uCE04\uB974 \uB9C9\uB300\uAE30\uB294 \uC544\uB2C8\uB77C\uB0E5."
    - "\uB2E4\uC591\uD55C \uB9C8\uBC95 \uC9C0\uD321\uC774\uAC00 \uC788\uB2E4\uC639.
      \uB124 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uB9C8\uBC95\uC744 \uCC3E\uC544\uBCF4\uB77C\uB0E5~"
    - "\uB9C8\uBC95 \uC9C0\uD321\uC774\uB294 \uC885\uB958\uAC00 \uB9CE\uB2E4\uC639.
      \uAC89\uBAA8\uC2B5\uB9CC \uBCF4\uC9C0 \uB9D0\uACE0 \uC124\uBA85\uB3C4 \uC77D\uC73C\uB77C\uB0E5."
    - "\uC5EC\uB7EC \uAC00\uC9C0 \uC9C0\uD321\uC774\uAC00\u2026 \uBC18\uC9DD\uC778\uB2E4\uB0E5\u2026
      \uC544, \uB9C8\uBC95\uB3C4 \uC0B4\uD3B4\uBCF4\uB77C\uB0E5."
    - "\uC608\uC05C \uB9C8\uBC95 \uC9C0\uD321\uC774\uAC00 \uAC00\uB4DD\uD558\uB2E4\uB0E5~
      \uACE8\uB77C\uBCF4\uB77C\uB0E5! \uB2E4 \uC798 \uC5B4\uC6B8\uB9B0\uB2E4\uB0E5~"
    - "\uB2E4\uC591\uD55C \uB9C8\uBC95 \uC9C0\uD321\uC774\uAC00 \uB9C8\uB828\uB418\uC5B4
      \uC788\uB2E4\uC639. \uC124\uBA85\uC744 \uBE44\uAD50\uD558\uBA70 \uC0B4\uD3B4\uBCF4\uC2DC\uB77C\uB0E5."
    - "\uC9C0\uD321\uC774\uAC00 \uB2E4\uC591\uD558\uB2E4\uC639. \uC774 \uBAB8\uC758
      \uD488\uACA9\uC5D0 \uC5B4\uC6B8\uB9B4 \uB9CC\uD55C \uAC78 \uCC3E\uC544\uBCF4\uB77C\uB0E5~
      \uB0D0~\uD558\uD558\uD558\uD558!!"
  - id: equip_and_back
    highlight: 3
    waitForTargetClick: 1
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uBB34\uAE30\uB97C \uC7A5\uCC29\uD574 \uBCF4\uB294 \uAC74 \uC5B4\uB5BB\uB0D0\uC639?
      \uB2E4 \uBD24\uC73C\uBA74 \uBC18\uC9DD\uC774\uB294 \uB4A4\uB85C\uAC00\uAE30\uB97C
      \uB204\uB974\uB77C\uB0E5!"
    - "\uC6D0\uD558\uB294 \uBB34\uAE30\uB97C \uC7A5\uCC29\uD574\uBCF4\uB77C\uB0E5.
      \uC900\uBE44\uB418\uBA74 \uD45C\uC2DC\uB41C \uB4A4\uB85C\uAC00\uAE30\uB97C
      \uB204\uB974\uBA74 \uB41C\uB2E4\uC639~"
    - "\uBB34\uAE30\uB3C4 \uC7A5\uCC29\uD574\uBCF4\uB77C\uB0E5. \uB2E4 \uBD24\uC73C\uBA74
      \uB4A4\uB85C\uAC00\uAE30\uB97C \uB20C\uB7EC\uB77C\uC639. \uAE30\uB2E4\uB824\uC904
      \uD14C\uB2C8\uAE4C."
    - "\uC7A5\uCC29\uB3C4 \uD574\uBCF4\uACE0\u2026 \uB098\uB294 \uC7A0\uAE50\u2026
      \uC544, \uB2E4 \uB410\uC73C\uBA74 \uB4A4\uB85C\uAC00\uAE30\uB97C \uB204\uB974\uB77C\uB0E5."
    - "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uBB34\uAE30\uB97C \uC7A5\uCC29\uD574\uBCF4\uB77C\uB0E5!
      \uB2E4 \uB410\uC73C\uBA74 \uB4A4\uB85C\uAC00\uAE30 \uCF55\uC774\uB2E4\uC639!"
    - "\uBB34\uAE30\uB97C \uC7A5\uCC29\uD574\uBCF4\uC2DC\uB77C\uB0E5. \uC0B4\uD3B4\uBCF4\uC2E0
      \uB4A4 \uD45C\uC2DC\uB41C \uB4A4\uB85C\uAC00\uAE30\uB85C \uB3CC\uC544\uAC00\uBA74
      \uB41C\uB2E4\uC639."
    - "\uBB34\uAE30\uB97C \uACE8\uB77C \uC7A5\uCC29\uD574\uBCF4\uB77C\uB0E5! \uC774\uBAB8\uC740
      \uBC14\uC058\uB2C8\uAE4C \uD45C\uC2DC\uB41C \uB4A4\uB85C\uAC00\uAE30\uB97C
      \uB20C\uB7EC\uB77C\uC639!"
  - id: battle_menu
    highlight: 4
    waitForTargetClick: 1
    animation: 6
    dreamyPauseSeconds: 1.2
    personalityLines:
    - "\uB2E4\uC74C\uC740 \uC804\uD22C\uB2E4\uB0E5! \uC804\uD22C \uBC84\uD2BC\uC740
      \uC800\uAE30\uB2E4\uC639. \uC774\uBC88\uC5D4 \uAE38 \uC548 \uC783\uC5C8\uB2E4\uB0E5!"
    - "\uB530\uB77C\uC624\uB77C\uB0E5~ \uC774\uBC88\uC5D4 \uC804\uD22C\uB97C \uC54C\uB824\uC8FC\uACA0\uB2E4\uC639.
      \uC804\uD22C \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uB77C\uB0E5!"
    - "\uC774\uC81C \uC804\uD22C\uB97C \uC54C\uB824\uC8FC\uACA0\uB2E4\uC639. \uB2E4\uCE58\uC9C0
      \uC54A\uAC8C \uC124\uBA85\uC740 \uC798 \uB4E4\uC73C\uB77C\uB0E5\u2026 \uC804\uD22C
      \uBC84\uD2BC\uC774\uB2E4\uC639."
    - "\uC774\uBC88\uC5D4\u2026 \uBB50\uC600\uB354\uB77C\u2026 \uC804\uD22C\uB2E4\uB0E5!
      \uBC18\uC9DD\uC774\uB294 \uC804\uD22C \uBC84\uD2BC\uC744 \uB204\uB974\uB77C\uB0E5."
    - "\uC774\uBC88\uC5D4 \uD568\uAED8 \uC804\uD22C\uB97C \uC54C\uC544\uBCF4\uC790\uB0E5~
      \uBC18\uC9DD\uC774\uB294 \uC804\uD22C \uBC84\uD2BC\uC744 \uCF55 \uB20C\uB7EC\uBCF4\uB77C\uB0E5"
    - "\uB2E4\uC74C\uC73C\uB85C \uC804\uD22C \uBA54\uB274\uB97C \uC548\uB0B4\uD558\uACA0\uB2E4\uC639.
      \uD45C\uC2DC\uB41C \uC804\uD22C \uBC84\uD2BC\uC744 \uC120\uD0DD\uD574\uC8FC\uC2DC\uB77C\uB0E5."
    - "\uC774\uBC88\uC5D4 \uC804\uD22C\uB97C \uBC30\uC6B8 \uCC28\uB840\uB2E4\uB0E5!
      \uC774 \uBAB8\uC758 \uC548\uB0B4\uB97C \uB530\uB77C \uC804\uD22C \uBC84\uD2BC\uC744
      \uB204\uB974\uB77C\uC639!"
  - id: training
    highlight: 5
    waitForTargetClick: 0
    animation: 8
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uD6C8\uB828\uC7A5\uC5D0\uC120 \uB9C8\uBC95 \uB85C\uBD07\uACFC \uB300\uB828\uD560
      \uC218 \uC788\uB2E4\uB0E5! \uBA3C\uC800 \uC5EC\uAE30\uC11C \uC5F0\uC2B5\uD558\uB77C\uC639.
      \uB098\uB3C4 \uAC00\uB054 \uD5DB\uC190\uC9C8\uD55C\uB2E4\uB0E5."
    - "\uD6C8\uB828\uC7A5\uC5D0\uC11C\uB294 \uB9C8\uBC95 \uB85C\uBD07\uACFC \uB300\uB828\uD558\uBA70
      \uC5F0\uC2B5\uD560 \uC218 \uC788\uB2E4\uB0E5. \uAC00\uC7A5 \uBA3C\uC800 \uC2DC\uD5D8\uD574\uBCF4\uAE38
      \uCD94\uCC9C\uD55C\uB2E4\uC639~"
    - "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB9C8\uBC95 \uB85C\uBD07\uACFC \uBA3C\uC800
      \uC5F0\uC2B5\uD558\uB77C\uB0E5. \uB124\uAC00 \uAC71\uC815\uB3FC\uC11C \uD558\uB294
      \uB9D0\uC740\u2026 \uC870\uAE08 \uB9DE\uB2E4\uC639."
    - "\uB85C\uBD07\uACFC \uC5F0\uC2B5\uD558\uB294 \uD6C8\uB828\uC7A5\uC774\uB2E4\uB0E5\u2026
      \uB85C\uBD07\uC740 \uC878\uC9C0 \uC54A\uACA0\uC9C0\uB0E5? \uCC98\uC74C\uC5D4
      \uC5EC\uAE30\uBD80\uD130 \uD574\uBCF4\uB77C\uC639."
    - "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB9C8\uBC95 \uB85C\uBD07\uACFC \uC5F0\uC2B5\uD574\uBCF4\uB77C\uB0E5~
      \uCC98\uC74C\uC5D4 \uC5EC\uAE30\uBD80\uD130! \uB0B4\uAC00 \uC751\uC6D0\uD55C\uB2E4\uC639~~~~"
    - "\uD6C8\uB828\uC7A5\uC5D0\uC11C\uB294 \uB9C8\uBC95 \uB85C\uBD07\uC744 \uC0C1\uB300\uB85C
      \uC2E4\uB825\uC744 \uC775\uD790 \uC218 \uC788\uB2E4\uC639. \uBA3C\uC800 \uC5F0\uC2B5\uD574\uBCF4\uC2DC\uAE38
      \uAD8C\uD55C\uB2E4\uB0E5."
    - "\uD6C8\uB828\uC7A5\uC5D0\uC11C \uB85C\uBD07\uACFC \uC5F0\uC2B5\uD558\uB77C\uB0E5!
      \uC774 \uBAB8\uC758 \uC81C\uC790\uB77C\uBA74 \uAE30\uBCF8\uAE30\uBD80\uD130
      \uAC16\uCDB0\uC57C \uD55C\uB2E4\uC639~"
  - id: create_room
    highlight: 6
    waitForTargetClick: 0
    animation: 3
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC5EC\uAE30\uC11C\uB294 \uBC29\uC744 \uB9CC\uB4E4\uC5B4 \uB2E4\uB978 \uB9C8\uB140\uC640
      \uACA8\uB8EC\uB2E4\uB0E5! \uBC29 \uCCAD\uC18C\uB294\u2026 \uADF8 \uBC29\uC774
      \uC544\uB2C8\uB0E5?"
    - "\uBC29\uC744 \uB9CC\uB4E4\uBA74 \uB2E4\uB978 \uB9C8\uB140\uC640 \uC2E4\uB825\uC744
      \uACA8\uB8F0 \uC218 \uC788\uB2E4\uC639. \uCE5C\uAD6C\uC640 \uD568\uAED8\uD574\uB3C4
      \uC88B\uB2E4\uB0E5~"
    - "\uC9C1\uC811 \uBC29\uC744 \uB9CC\uB4E4\uC5B4 \uB2E4\uB978 \uB9C8\uB140\uC640
      \uACA8\uB8F0 \uC218\uB3C4 \uC788\uB2E4\uC639. \uC5F0\uC2B5\uD55C \uAC78 \uBCF4\uC5EC\uC8FC\uB77C\uB0E5."
    - "\uBC29 \uB9CC\uB4E4\uAE30\u2026 \uB0AE\uC7A0 \uBC29 \uB9D0\uACE0 \uB300\uC804
      \uBC29\uC774\uB2E4\uB0E5. \uB2E4\uB978 \uB9C8\uB140\uC640 \uC2E4\uB825\uC744
      \uACA8\uB904\uBCF4\uB77C\uC639."
    - "\uBC29\uC744 \uB9CC\uB4E4\uC5B4 \uCE5C\uAD6C \uB9C8\uB140\uC640 \uB300\uACB0\uD574\uBCF4\uB77C\uB0E5~
      \uD568\uAED8\uD558\uBA74 \uB354 \uC990\uAC81\uB2E4\uC639"
    - "\uBC29\uC744 \uC0DD\uC131\uD558\uC5EC \uB2E4\uB978 \uB9C8\uB140\uC640 \uB300\uACB0\uD558\uC2E4
      \uC218 \uC788\uB2E4\uC639."
    - "\uB124 \uBC29\uC744 \uB9CC\uB4E4\uC5B4 \uB2E4\uB978 \uB9C8\uB140\uB97C \uCD08\uB300\uD558\uB77C\uB0E5!
      \uBA4B\uC9C4 \uC2B9\uBD80\uB97C \uBCF4\uC5EC\uC8FC\uB77C\uC639~"
  - id: bot_rooms
    highlight: 6
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB85C\uBD07 \uB9C8\uB140\uB3C4 \uC900\uBE44\uB418\uC5B4 \uC788\uB2E4\uB0E5!
      \uC9C4\uC9DC \uB9C8\uB140\uB791 \uD5F7\uAC08\uB9B4\uC9C0\uB3C4\u2026 \uB2E4\uC591\uD55C
      \uB9C8\uBC95\uC73C\uB85C \uC5F0\uC2B5\uD558\uB77C\uC639."
    - "\uB85C\uBD07 \uB9C8\uB140\uB4E4\uACFC \uACA8\uB8E8\uB294 \uBAA8\uB4DC\uB3C4
      \uC788\uB2E4\uB0E5. \uB2E4\uC591\uD55C \uB9C8\uBC95\uC744 \uC0AC\uC6A9\uD558\uBA70
      \uC2E4\uB825\uC744 \uD0A4\uC6CC\uBCF4\uB77C\uC639~"
    - "\uB85C\uBD07 \uB9C8\uB140\uC640\uB3C4 \uB300\uC804\uD560 \uC218 \uC788\uB2E4\uC639.
      \uC5EC\uB7EC \uB9C8\uBC95\uC744 \uC368\uBCF4\uACE0 \uB124 \uBC29\uC2DD\uC744
      \uCC3E\uC73C\uB77C\uB0E5."
    - "\uB85C\uBD07 \uB9C8\uB140\uB3C4 \uC788\uB2E4\uC639\u2026 \uC5B4, \uC544\uAE4C
      \uB85C\uBD07\uC774\uB791 \uB2E4\uB974\uB0D0\uB0E5? \uC5EC\uB7EC \uB9C8\uBC95\uC744
      \uC2DC\uD5D8\uD574\uBCF4\uB77C\uC639."
    - "\uB85C\uBD07 \uB9C8\uB140\uB3C4 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4\uB0E5!
      \uC5EC\uB7EC \uB9C8\uBC95\uC744 \uC368\uBCF4\uBA74\uC11C \uC465\uC465 \uC131\uC7A5\uD558\uB77C\uC639"
    - "\uB85C\uBD07 \uB9C8\uB140\uC640 \uB300\uB828\uD558\uB294 \uBAA8\uB4DC\uB3C4
      \uC900\uBE44\uB418\uC5B4 \uC788\uB2E4\uC639. \uC5EC\uB7EC \uB9C8\uBC95\uC758
      \uC6B4\uC6A9\uC744 \uC775\uD600\uBCF4\uC2DC\uB77C\uB0E5."
    - "\uB85C\uBD07 \uB9C8\uB140\uB3C4 \uC0C1\uB300\uD574\uC8FC\uACA0\uB2E4\uB0E5!
      \uB2E4\uC591\uD55C \uB9C8\uBC95\uC744 \uC775\uD600 \uC774 \uBAB8\uC744 \uBE5B\uB0B4\uC8FC\uB77C\uC639~"
  - id: random_match
    highlight: 7
    waitForTargetClick: 0
    animation: 3
    dreamyPauseSeconds: 1.3
    personalityLines:
    - "\uBB34\uC791\uC704 \uB9E4\uCE6D\uC740 \uCC98\uC74C \uBCF4\uB294 \uB9C8\uB140\uB97C
      \uB9CC\uB098\uB294 \uACF3\uC774\uB2E4\uB0E5! \uCE04\uB974 \uB098\uB214\uD68C\uB294
      \uC544\uB2C8\uB2E4\uC639."
    - "\uBB34\uC791\uC704 \uB9E4\uCE6D\uC5D0\uC11C\uB294 \uC0C8\uB85C\uC6B4 \uB9C8\uB140\uB4E4\uC744
      \uB9CC\uB098 \uC2E4\uB825\uC744 \uACA8\uB904\uBCFC \uC218 \uC788\uB2E4\uC639."
    - "\uBB34\uC791\uC704 \uB9E4\uCE6D\uC740 \uBAA8\uB974\uB294 \uB9C8\uB140\uC640
      \uACA8\uB8E8\uB294 \uACF3\uC774\uB2E4\uC639. \uC0C1\uB300\uAC00 \uB9CC\uB9CC\uD560
      \uAC70\uB77C \uC0DD\uAC01\uD558\uC9C0 \uB9C8\uB77C\uB0E5."
    - "\uBB34\uC791\uC704 \uB9C8\uB140\uB97C \uB9CC\uB098\u2026 \uBB50 \uD588\uB354\uB77C\u2026
      \uB9DE\uB2E4, \uC2E4\uB825\uC744 \uACA8\uB8E8\uB294 \uACF3\uC774\uB2E4\uB0E5."
    - "\uBB34\uC791\uC704 \uB9E4\uCE6D\uC5D0\uC11C\uB294 \uC0C8\uB85C\uC6B4 \uB9C8\uB140\uB97C
      \uB9CC\uB09C\uB2E4\uB0E5~ \uB450\uADFC\uB450\uADFC \uC2B9\uBD80\uB2E4\uC639"
    - "\uBB34\uC791\uC704 \uB9E4\uCE6D\uC5D0\uC11C\uB294 \uB2E4\uB978 \uB9C8\uB140\uB4E4\uACFC
      \uC2E4\uB825\uC744 \uACA8\uB8E8\uAC8C \uB41C\uB2E4\uC639.\n\uD56D\uC0C1 \uD488\uC704\uB97C
      \uC9C0\uCF1C\uC57C\uD55C\uB2E4\uB0E5."
    - "\uBB34\uC791\uC704 \uB9E4\uCE6D\uC5D0\uC11C \uC774\uB984\uC744 \uB5A8\uCCD0\uBCF4\uB77C\uB0E5!
      \uB2E4\uC591\uD55C \uB9C8\uB140\uC640 \uC2B9\uBD80\uD558\uB294 \uACF3\uC774\uB2E4\uC639~"
  - id: random_warning
    highlight: 7
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uCD08\uBCF4 \uB9C8\uB140\uC5D0\uAC90 \uC5B4\uB824\uC6B8 \uC218 \uC788\uB2E4\uB0E5!
      \uC900\uBE44\uD558\uACE0 \uAC00\uB77C\uC639. \uB098\uB294 \uC900\uBE44\uBB3C\uC744
      \uC790\uC8FC \uC78A\uB294\uB2E4\uB0E5\u2026"
    - "\uCC98\uC74C\uC5D0\uB294 \uC870\uAE08 \uC5B4\uB824\uC6B8 \uC218 \uC788\uB2E4\uB0E5.
      \uCDA9\uBD84\uD788 \uC5F0\uC2B5\uD558\uACE0 \uC790\uC2E0\uAC10\uC774 \uC0DD\uAE30\uBA74
      \uB3C4\uC804\uD558\uB77C\uC639~"
    - "\uCD08\uBCF4\uAC00 \uBC14\uB85C \uB4E4\uC5B4\uAC00\uBA74 \uD798\uB4E4 \uC218
      \uC788\uB2E4\uC639. \uCDA9\uBD84\uD788 \uC900\uBE44\uD558\uB77C\uB0E5. \uAD1C\uD788
      \uB2E4\uCE58\uBA74\u2026 \uACE4\uB780\uD558\uB2C8\uAE4C."
    - "\uCD08\uBCF4\uC5D0\uAC90 \uC5B4\uB824\uC6B8 \uC218 \uC788\uB2E4\uB0E5\u2026
      \uC878\uC9C0 \uB9D0\uACE0 \uCDA9\uBD84\uD788 \uC900\uBE44\uD574\uC11C \uB4E4\uC5B4\uAC00\uB77C\uC639."
    - "\uCC98\uC74C\uC5D4 \uC5B4\uB824\uC6B8 \uC218\uB3C4 \uC788\uB2E4\uB0E5. \uCDA9\uBD84\uD788
      \uC5F0\uC2B5\uD558\uACE0 \uB3C4\uC804\uD558\uB77C\uC639! \uB10C \uD560 \uC218
      \uC788\uB2E4\uB0E5\u2661"
    - "\uCD08\uBCF4 \uB9C8\uB140\uC5D0\uAC8C\uB294 \uC5B4\uB824\uC6B4 \uC0C1\uB300\uB97C
      \uB9CC\uB0A0 \uC218 \uC788\uB2E4\uC639. \uCDA9\uBD84\uD788 \uC900\uBE44\uD558\uC2E0
      \uB4A4 \uB3C4\uC804\uD558\uC2DC\uB77C\uB0E5."
    - "\uC900\uBE44 \uC5C6\uC774 \uB4E4\uC5B4\uAC00\uBA74 \uC548 \uB41C\uB2E4\uC639!
      \uCDA9\uBD84\uD788 \uC2E4\uB825\uC744 \uC313\uACE0 \uB2F9\uB2F9\uD558\uAC8C
      \uB3C4\uC804\uD558\uB77C\uB0E5~"
  - id: return
    highlight: 8
    waitForTargetClick: 1
    animation: 3
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC774\uC81C \uB3CC\uC544\uAC00\uC790\uB0E5! \uB4A4\uB85C\uAC00\uAE30\u2026
      \uC774\uBC88\uC5D4 \uC815\uD655\uD788 \uCC3E\uC558\uB2E4\uC639. \uB20C\uB7EC\uBCF4\uB77C\uB0E5!"
    - "\uC124\uBA85\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4\uB0E5~ \uD45C\uC2DC\uB41C
      \uB4A4\uB85C\uAC00\uAE30\uB97C \uB20C\uB7EC \uD568\uAED8 \uB3CC\uC544\uAC00\uB77C\uC639."
    - "\uB2E4 \uB4E4\uC5C8\uC73C\uBA74 \uB4A4\uB85C\uAC00\uAE30\uB97C \uB20C\uB7EC\uB77C\uB0E5.
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD560 \uB9D0\uC774 \uC788\uB2E4\uC639."
    - "\uC774\uC81C \uB3CC\uC544\uAC00\u2026 \uC5B4\uB514\uB85C? \uC544, \uB4A4\uB85C\uAC00\uAE30\uB97C
      \uB204\uB974\uB77C\uB0E5."
    - "\uB4A4\uB85C\uAC00\uAE30\uB97C \uCF55 \uB20C\uB7EC \uB3CC\uC544\uAC00\uC790\uB0E5~
      \uB9C8\uC9C0\uB9C9 \uC778\uC0AC\uAC00 \uB0A8\uC558\uB2E4\uC639"
    - "\uC548\uB0B4\uB97C \uB9C8\uCE58\uACE0 \uB3CC\uC544\uAC00\uACA0\uB2E4\uC639.
      \uD45C\uC2DC\uB41C \uB4A4\uB85C\uAC00\uAE30\uB97C \uC120\uD0DD\uD574\uC8FC\uC2DC\uB77C\uB0E5."
    - "\uC774\uC81C \uB4A4\uB85C\uAC00\uAE30\uB97C \uB204\uB974\uB77C\uB0E5! \uC774
      \uBAB8\uC758 \uB9C8\uC9C0\uB9C9 \uD658\uC601 \uC778\uC0AC\uB97C \uB4E4\uC73C\uB77C\uC639~"
  - id: welcome
    highlight: 0
    waitForTargetClick: 0
    animation: 11
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB2E4\uC2DC \uD55C\uBC88 \uB9C8\uBC95 \uD559\uAD50\uC5D0 \uC628 \uAC78 \uD658\uC601\uD55C\uB2E4\uB0E5!
      \uD559\uAD50 \uC774\uB984\uC740\u2026 \uC544\uBB34\uD2BC \uD658\uC601\uC774\uB2E4\uC639!"
    - "\uB2E4\uC2DC \uD55C\uBC88 \uB9C8\uBC95 \uD559\uAD50\uC5D0 \uC628 \uAC78 \uD658\uC601\uD55C\uB2E4\uB0E5!
      \uC990\uAC70\uC6B4 \uD559\uAD50\uC0DD\uD65C\uC774 \uB418\uAE38 \uBC14\uB780\uB2E4\uC639~"
    - "\uB9C8\uBC95 \uD559\uAD50\uC5D0 \uC628 \uAC78\u2026 \uD658\uC601\uD55C\uB2E4\uB0E5.
      \uD55C \uBC88\uB9CC \uB9D0\uD560 \uD14C\uB2C8 \uC798 \uAE30\uC5B5\uD558\uB77C\uC639."
    - "\uB9C8\uBC95 \uD559\uAD50\uC5D0 \uC628 \uAC78 \uD658\uC601\uD55C\uB2E4\uB0E5\u2026
      \uD658\uC601 \uC778\uC0AC \uD588\uC5C8\uB098\uB0E5? \uD55C \uBC88 \uB354 \uD558\uBA74
      \uC88B\uB2E4\uC639."
    - "\uB9C8\uBC95 \uD559\uAD50\uC5D0 \uC628 \uAC78 \uC815\uB9D0 \uC815\uB9D0 \uD658\uC601\uD55C\uB2E4\uB0E5~
      \uC6B0\uB9AC \uC990\uAC81\uAC8C \uC9C0\uB0B4\uC790\uC639!"
    - "\uB2E4\uC2DC \uD55C\uBC88 \uB9C8\uBC95 \uD559\uAD50\uC5D0 \uC624\uC2E0 \uAC83\uC744
      \uC9C4\uC2EC\uC73C\uB85C \uD658\uC601\uD55C\uB2E4\uC639."
    - "\uB9C8\uBC95 \uD559\uAD50\uC5D0 \uC628 \uAC78 \uD658\uC601\uD55C\uB2E4\uB0E5!
      \uC774 \uBAB8\uC774 \uC9C1\uC811 \uD658\uC601\uD574\uC8FC\uB294 \uAC70\uB2E4\uC639~
      \uB0D0~\uD558\uD558\uD558\uD558\uD558!"
  - id: stay_together
    highlight: 0
    waitForTargetClick: 0
    animation: 10
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB09C \uB124 \uACC1\uC5D0\uC11C \uB3C4\uC640\uC8FC\uACA0\uB2E4\uB0E5! \uB098\uB97C
      \uAFB9 \uB204\uB974\uACE0 \uC704\uC544\uB798\uB85C \uBB38\uC9C8\uB7EC\uC8FC\uB77C\uB0E5.
      \uCE04\uB974 \uB9D0\uACE0 \uC4F0\uB2F4\uB3C4 \uC88B\uB2E4\uC639!"
    - "\uB298 \uACC1\uC5D0\uC11C \uB3C4\uC640\uC904 \uD14C\uB2C8 \uD798\uB0B4\uB77C\uB0E5!
      \uB098\uB97C \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C \uC6C0\uC9C1\uC774\uBA74
      \uC4F0\uB2E4\uB4EC\uC744 \uC218 \uC788\uB2E4\uC639~"
    - "\uACC1\uC5D0 \uC788\uC5B4\uC8FC\uACA0\uB2E4\uB0E5. \uB098\uB97C \uB204\uB978
      \uCC44 \uC704\uC544\uB798\uB85C \uC4F0\uB2E4\uB4EC\uC5B4\uB3C4 \uB41C\uB2E4\uC639.
      \uC88B\uC544\uC11C \uADF8\uB7EC\uB294 \uAC74 \uC544\uB2C8\uB2E4\uB0E5!"
    - "\uB124 \uACC1\uC5D0 \uB5A0 \uC788\uACA0\uB2E4\uB0E5\u2026 \uB098\uB97C \uAFB9
      \uB204\uB974\uACE0 \uC704\uC544\uB798\uB85C \uC4F0\uB2E4\uB4EC\uC5B4 \uAE68\uC6CC\uC8FC\uB77C\uC639\u2026
      \uB610 \uC878\uC558\uB2E4\uB0E5."
    - "\uD56D\uC0C1 \uC751\uC6D0\uD55C\uB2E4\uB0E5 \uB098\uB97C \uAFB9 \uB204\uB974\uACE0
      \uC704\uC544\uB798\uB85C \uC4F0\uB2F4\uC4F0\uB2F4\uD574\uC8FC\uB77C\uC639~"
    - "\uC55E\uC73C\uB85C\uB3C4 \uACC1\uC5D0\uC11C \uB3D5\uACA0\uB2E4\uC639. \uC800\uB97C
      \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C \uC6C0\uC9C1\uC5EC \uC4F0\uB2E4\uB4EC\uC5B4\uC8FC\uC2DC\uB77C\uB0E5."
    - "\uC774 \uBAB8\uC774 \uACC1\uC744 \uC9C0\uCF1C\uC8FC\uACA0\uB2E4\uB0E5! \uB098\uB97C
      \uB204\uB978 \uCC44 \uC704\uC544\uB798\uB85C \uC815\uC131\uAECF \uC4F0\uB2E4\uB4EC\uB294\uAC78
      \uD5C8\uB77D\uD558\uACA0\uB2E4\uC639~"
  trainingTutorial:
  - id: flag
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uAE43\uBC1C\uC744 \uB9C8\uC9C0\uB9C9\uC5D0 \uAC00\uC9C4 \uD300\uC774 \uC774\uAE34\uB2E4\uC639!
      \uBA3C\uC800 \uBA39\uC73C\uBA74 \uB05D\u2026\uC740 \uC544\uB2C8\uB77C\uB0E5!
      \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uCC59\uACA8\uC57C \uD55C\uB2E4\uC639."
    - "\uC774 \uAC8C\uC784\uC740 \uC81C\uD55C \uC2DC\uAC04\uC774 \uB05D\uB0A0 \uB54C
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uAE43\uBC1C\uC744 \uAC00\uC9C4 \uD300\uC774
      \uC774\uAE34\uB2E4\uC639! \uD300\uC774 \uD568\uAED8 \uC9C0\uD0A4\uB294 \uAC83\uC774
      \uC911\uC694\uD558\uB2E4\uB0E5."
    - "\uC2DC\uAC04\uC774 \uB05D\uB0A0 \uB54C \uB9C8\uC9C0\uB9C9 \uAE43\uBC1C \uC18C\uC720
      \uD300\uC774 \uC2B9\uB9AC\uD55C\uB2E4\uB0E5. \uBA3C\uC800 \uBA39\uC5C8\uB2E4\uACE0
      \uBC29\uC2EC\uD558\uC9C0 \uB9D0\uB77C\uC639."
    - "\uAE43\uBC1C\u2026 \uBC18\uC9DD\uC778\uB2E4\uB0E5. \uC544, \uC2DC\uAC04\uC774
      \uB05D\uB0A0 \uB54C \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uAC00\uC9C4 \uD300\uC774
      \uC774\uAE34\uB2E4\uC639."
    - "\uBC18\uC9DD\uBC18\uC9DD \uAE43\uBC1C\uC774 \uC2B9\uB9AC\uC758 \uC5F4\uC1E0\uB2E4\uB0E5\u2661
      \uC2DC\uAC04\uC774 \uB05D\uB0A0 \uB54C \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uAC00\uC9C4
      \uD300\uC774 \uC2B9\uB9AC\uD55C\uB2E4\uC639!"
    - "\uC81C\uD55C \uC2DC\uAC04 \uC885\uB8CC \uC2DC \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uAE43\uBC1C\uC744 \uC18C\uC720\uD55C \uD300\uC774 \uC2B9\uB9AC\uD55C\uB2E4\uC639.
      \uC798 \uAE30\uC5B5\uD574\uC8FC\uC2DC\uB77C\uB0E5."
    - "\uC2B9\uB9AC\uC758 \uAE43\uBC1C\uC740 \uC774 \uBAB8\uC5D0\uAC8C \uC5B4\uC6B8\uB9B0\uB2E4\uB0E5!
      \uC2DC\uAC04\uC774 \uB05D\uB0A0 \uB54C \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uAC00\uC9C4
      \uD300\uC774 \uC774\uAE34\uB2E4\uC639."
  - id: speed
    practice: 1
    highlight: 0
    waitForTargetClick: 0
    animation: 4
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "{accelerate}\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uace0 S\ub85c \ub2e4\uc2dc \ub0ae\ucdb0 \ubcf4\ub77c\ub0e5! \u2026\uc5b4, \ub0b4\uac00 \ub204\ub974\ub294 \uac74 \uc544\ub2c8\uc9c0\ub0e5?"
    - "{accelerate}\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uace0 S\ub85c \ub2e4\uc2dc \ub0ae\ucdb0 \ubcf4\ub77c\ub0e5~ \ucc9c\ucc9c\ud788 \ud574\ub3c4 \uad1c\ucc2e\ub2e4\uc639!"
    - "{accelerate}\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uace0 S\ub85c \ub2e4\uc2dc \ub0ae\ucdb0 \ubcf4\ub77c\ub0e5. \ub124\uac00 \ud560 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub824 \uc8fc\ub294 \uac74 \ud2b9\ubcc4\ud788\ub2e4\uc639!"
    - "\u2026\u2026\uc5b4\ub514\uae4c\uc9c0 \ud588\ub354\ub77c\ub0e5\u2026 {accelerate}\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uace0 S\ub85c \ub2e4\uc2dc \ub0ae\ucdb0 \ubcf4\ub77c\ub0e5\u2026"
    - "{accelerate}\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uace0 S\ub85c \ub2e4\uc2dc \ub0ae\ucdb0 \ubcf4\ub77c\ub0e5\u2661 \uc606\uc5d0\uc11c \uc751\uc6d0\ud558\uaca0\ub2e4\ub0e5~"
    - "{accelerate}\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uace0 S\ub85c \ub2e4\uc2dc \ub0ae\ucdb0 \ubcf4\uc2dc\uaca0\uc2b5\ub2c8\uae4c\uc639? \uc900\ube44\ub418\uc2dc\uba74 \uc2e4\uc2b5\uc744 \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624\ub0e5."
    - "{accelerate}\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uace0 S\ub85c \ub2e4\uc2dc \ub0ae\ucdb0 \ubcf4\ub77c\ub0e5! \uc774 \ubab8 \uc55e\uc5d0\uc11c \uba4b\uc9c0\uac8c \ubcf4\uc5ec \uc8fc\ub77c\uc639!"
  - id: aim
    practice: 2
    highlight: 0
    waitForTargetClick: 0
    animation: 8
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uc5f0\uc2b5\uc6a9 \ud654\uc5fc \ub9c8\ubc95\uc774\ub2e4\ub0e5. \uc55e\uc758 \ubd07\uc744 \ud5a5\ud574 {aim}\uc744 \ub204\ub974\uace0, \ucd08\ub85d\uc0c9\uc73c\ub85c \ub85d\uc628\uc774 \uc644\ub8cc\ub418\uba74 \ub5bc\uc5b4\uc11c \ubc1c\uc0ac\ud574 \ubcf4\ub77c\ub0e5! \u2026\uc5b4, \ub0b4\uac00 \ub204\ub974\ub294 \uac74 \uc544\ub2c8\uc9c0\ub0e5?"
    - "\uc5f0\uc2b5\uc6a9 \ud654\uc5fc \ub9c8\ubc95\uc774\ub2e4\ub0e5. \uc55e\uc758 \ubd07\uc744 \ud5a5\ud574 {aim}\uc744 \ub204\ub974\uace0, \ucd08\ub85d\uc0c9\uc73c\ub85c \ub85d\uc628\uc774 \uc644\ub8cc\ub418\uba74 \ub5bc\uc5b4\uc11c \ubc1c\uc0ac\ud574 \ubcf4\ub77c\ub0e5~ \ucc9c\ucc9c\ud788 \ud574\ub3c4 \uad1c\ucc2e\ub2e4\uc639!"
    - "\uc5f0\uc2b5\uc6a9 \ud654\uc5fc \ub9c8\ubc95\uc774\ub2e4\ub0e5. \uc55e\uc758 \ubd07\uc744 \ud5a5\ud574 {aim}\uc744 \ub204\ub974\uace0, \ucd08\ub85d\uc0c9\uc73c\ub85c \ub85d\uc628\uc774 \uc644\ub8cc\ub418\uba74 \ub5bc\uc5b4\uc11c \ubc1c\uc0ac\ud574 \ubcf4\ub77c\ub0e5. \ub124\uac00 \ud560 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub824 \uc8fc\ub294 \uac74 \ud2b9\ubcc4\ud788\ub2e4\uc639!"
    - "\u2026\u2026\uc5b4\ub514\uae4c\uc9c0 \ud588\ub354\ub77c\ub0e5\u2026 \uc5f0\uc2b5\uc6a9 \ud654\uc5fc \ub9c8\ubc95\uc774\ub2e4\ub0e5. \uc55e\uc758 \ubd07\uc744 \ud5a5\ud574 {aim}\uc744 \ub204\ub974\uace0, \ucd08\ub85d\uc0c9\uc73c\ub85c \ub85d\uc628\uc774 \uc644\ub8cc\ub418\uba74 \ub5bc\uc5b4\uc11c \ubc1c\uc0ac\ud574 \ubcf4\ub77c\ub0e5\u2026"
    - "\uc5f0\uc2b5\uc6a9 \ud654\uc5fc \ub9c8\ubc95\uc774\ub2e4\ub0e5. \uc55e\uc758 \ubd07\uc744 \ud5a5\ud574 {aim}\uc744 \ub204\ub974\uace0, \ucd08\ub85d\uc0c9\uc73c\ub85c \ub85d\uc628\uc774 \uc644\ub8cc\ub418\uba74 \ub5bc\uc5b4\uc11c \ubc1c\uc0ac\ud574 \ubcf4\ub77c\ub0e5\u2661 \uc606\uc5d0\uc11c \uc751\uc6d0\ud558\uaca0\ub2e4\ub0e5~"
    - "\uc5f0\uc2b5\uc6a9 \ud654\uc5fc \ub9c8\ubc95\uc774\ub2e4\ub0e5. \uc55e\uc758 \ubd07\uc744 \ud5a5\ud574 {aim}\uc744 \ub204\ub974\uace0, \ucd08\ub85d\uc0c9\uc73c\ub85c \ub85d\uc628\uc774 \uc644\ub8cc\ub418\uba74 \ub5bc\uc5b4\uc11c \ubc1c\uc0ac\ud574 \ubcf4\uc2dc\uaca0\uc2b5\ub2c8\uae4c\uc639? \uc900\ube44\ub418\uc2dc\uba74 \uc2e4\uc2b5\uc744 \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624\ub0e5."
    - "\uc5f0\uc2b5\uc6a9 \ud654\uc5fc \ub9c8\ubc95\uc774\ub2e4\ub0e5. \uc55e\uc758 \ubd07\uc744 \ud5a5\ud574 {aim}\uc744 \ub204\ub974\uace0, \ucd08\ub85d\uc0c9\uc73c\ub85c \ub85d\uc628\uc774 \uc644\ub8cc\ub418\uba74 \ub5bc\uc5b4\uc11c \ubc1c\uc0ac\ud574 \ubcf4\ub77c\ub0e5! \uc774 \ubab8 \uc55e\uc5d0\uc11c \uba4b\uc9c0\uac8c \ubcf4\uc5ec \uc8fc\ub77c\uc639!"
  - id: release
    highlight: 0
    waitForTargetClick: 0
    animation: 8
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uC870\uC900\uC774 \uCD08\uB85D\uC0C9\uC774\uBA74 \uC900\uBE44 \uB05D\uC774\uB2E4\uB0E5!
      \uADF8\uB54C {aim}\uC744 \uB5BC\uBA74 \uC29D~ \uD558\uACE0 \uBC1C\uC0AC\uB41C\uB2E4\uC639!"
    - "\uC870\uC900\uC774 \uC644\uB8CC\uB418\uBA74 \uD45C\uC2DD\uC774 \uCD08\uB85D\uC0C9\uC73C\uB85C
      \uBCC0\uD55C\uB2E4\uC639. \uADF8\uB54C {aim}\uC744 \uB5BC\uBA74 \uB9C8\uBC95\uC774
      \uBC1C\uC0AC\uB41C\uB2E4\uB0E5."
    - "\uCD08\uB85D\uC0C9\uC740 \uC870\uC900\uC774 \uB05D\uB0AC\uB2E4\uB294 \uB73B\uC774\uB2E4\uB0E5.
      \uC644\uB8CC\uB418\uBA74 {aim}\uC744 \uB5BC\uC5B4\uC11C \uBC1C\uC0AC\uD558\uBA74
      \uB41C\uB2E4\uC639."
    - "\uCD08\uB85D\uC0C9\u2026 \uB208 \uC0C9 \uAC19\uAE30\uB3C4 \uD558\uB2E4\uB0E5.
      \uC870\uC900\uC774 \uB05D\uB09C \uAC70\uB2C8\uAE4C {aim}\uC744 \uB5BC\uBA74
      \uBC1C\uC0AC\uB41C\uB2E4\uC639."
    - "\uCD08\uB85D\uC0C9\uC73C\uB85C \uBC18\uC9DD\uC774\uBA74 \uC900\uBE44 \uC644\uB8CC\uB0E5\u2661
      {aim}\uC744 \uB5BC\uBA74 \uB9C8\uBC95\uC774 \uB0A0\uC544\uAC04\uB2E4\uC639!"
    - "\uCD08\uB85D\uC0C9 \uD45C\uC2DD\uC740 \uC870\uC900 \uC644\uB8CC\uB97C \uB73B\uD55C\uB2E4\uC639.
      \uADF8\uB54C {aim}\uC744 \uB193\uC73C\uBA74 \uB9C8\uBC95\uC774 \uBC1C\uC0AC\uB41C\uB2E4\uB0E5."
    - "\uCD08\uB85D\uC0C9\uC73C\uB85C \uBCC0\uD558\uBA74 \uC900\uBE44 \uC644\uB8CC\uB2E4\uB0E5!
      \uADF8\uB54C {aim}\uC744 \uB193\uC73C\uBA74 \uBA4B\uC9C0\uAC8C \uBC1C\uC0AC\uB41C\uB2E4\uC639."
  - id: instant_magic
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uC5B4\uB77C, \uC77C\uBD80 \uB9C8\uBC95\uC740 \uC870\uC900\uC774 \uD544\uC694
      \uC5C6\uB2E4\uC639! \uCD08\uB85D\uC0C9\uB9CC \uAE30\uB2E4\uB9AC\uB2E4 \uB0AE\uC7A0
      \uC790\uBA74 \uC548 \uB41C\uB2E4\uB0E5."
    - "\uC77C\uBD80 \uB9C8\uBC95\uC740 \uC870\uC900\uC774 \uD544\uC694 \uC5C6\uB294
      \uACBD\uC6B0\uB3C4 \uC788\uB2E4\uC639. \uB9C8\uBC95\uB9C8\uB2E4 \uC870\uC900
      \uBC29\uC2DD\uACFC \uC0AC\uC6A9 \uC870\uAC74\uC774 \uB2E4\uB974\uB2E4\uB0E5."
    - "\uBAA8\uB4E0 \uB9C8\uBC95\uC774 \uC870\uC900\uC744 \uAE30\uB2E4\uB9AC\uB294
      \uAC74 \uC544\uB2C8\uB2E4\uB0E5. \uC870\uC900 \uC5C6\uC774 \uBC14\uB85C \uC4F0\uB294
      \uB9C8\uBC95\uB3C4 \uC788\uB2E4\uB294 \uB73B\uC774\uB2E4\uC639."
    - "\uC870\uC900\u2026 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB098\uB0E5? \uC77C\uBD80
      \uB9C8\uBC95\uC740 \uC870\uC900\uC774 \uD544\uC694 \uC5C6\uB2E4\uC639. \uC0AC\uC6A9
      \uBC29\uC2DD\uC740 \uB9C8\uBC95\uB9C8\uB2E4 \uB2E4\uB974\uB2E4\uB0E5."
    - "\uC870\uC900 \uC5C6\uC774 \uC4F8 \uC218 \uC788\uB294 \uB9C8\uBC95\uB3C4 \uC788\uB2E4\uC639\u2661
      \uB9C8\uBC95\uB9C8\uB2E4 \uC0AC\uC6A9 \uBC29\uC2DD\uB3C4 \uB2E4\uB974\uB2E4\uB0E5!"
    - "\uC77C\uBD80 \uB9C8\uBC95\uC740 \uC870\uC900 \uC5C6\uC774 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uB2E4\uC639. \uC0AC\uC6A9 \uBC29\uC2DD\uC740 \uAC01 \uB9C8\uBC95\uC758
      \uC124\uBA85\uC5D0\uB3C4 \uC801\uD600 \uC788\uB2E4\uB0E5."
    - "\uC870\uC900\uC774 \uD544\uC694 \uC5C6\uB294 \uB9C8\uBC95\uB3C4 \uC788\uB2E4\uB0E5!
      \uBAA8\uB4E0 \uB9C8\uBC95\uC744 \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uB2E4\uB8E8\uB824
      \uD558\uC9C0 \uB9D0\uB77C\uC639."
  - id: slots
    practice: 3
