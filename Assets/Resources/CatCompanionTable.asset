    - "\u2026\u2026\uc5b4\ub514\uae4c\uc9c0 \ud588\ub354\ub77c\ub0e5\u2026 {slot2}\ub85c 2\ubc88 \ub9c8\ubc95\uc744 \uc120\ud0dd\ud558\uace0 {slot1}\ub85c 1\ubc88 \ub9c8\ubc95\uc73c\ub85c \ub3cc\uc544\uc640 \ubcf4\ub77c\ub0e5\u2026"
