  m_Script: {fileID: 11500000, guid: 271d0c6264084a7c9be196f9cdbfbeb7, type: 3}
  m_Name: CatCompanionTable
  m_EditorClassIdentifier: 
  catPrefab: {fileID: 2466759643076185548, guid: 7f9096ba70eb4764c8fb1b00535460c2, type: 3}
  paperAirplanePrefab: {fileID: 6017417974894778097, guid: 810e7f1c1002ac44c9a41caab9101ec2, type: 3}
  tutorialPrefab: {fileID: 4614782080702164151, guid: 19c7c37a63078d548abc10d298ce5085, type: 3}
  useCatForSummon: 1
  greetingSeconds: 3
  greetingFadeSeconds: 0.35
  returningGreetings:
  - id: returningGreetings_0
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC5B4\uB77C? \uB108 \uB204\uAD6C\u2026 \uC544! \uC624\uB79C\uB9CC\uC774\uB2E4\uB0E5!"
    - "\uC624\uB79C\uB9CC\uC774\uB2E4\uB0E5! \uB2E4\uC2DC \uB9CC\uB098\uC11C \uBC18\uAC11\uB2E4\uC639~"
    - "\uC624\uB79C\uB9CC\uC774\uB124. \uB531\uD788 \uBC18\uAC00\uC6B4 \uAC74 \uC544\uB2C8\uB2E4\uB0E5!"
    - "\u2026\u2026\uC5B4? \uC624\uB79C\uB9CC\uC774\uB2E4\uB0E5\u2026"
    - "\uC624\uB79C\uB9CC\uC774\uB2E4\uB0E5~ \uBCF4\uACE0 \uC2F6\uC5C8\uB2E4\uB0E5!!!"
    - "\uC624\uB79C\uB9CC\uC5D0 \uBD59\uC2B5\uB2C8\uB2E4, \uB9C8\uB140\uB2D8. \uBC18\uAC11\uB2E4\uC639."
    - "\uC624\uB79C\uB9CC\uC774\uAD6C\uB098\uB0E5! \uC774 \uBAB8\uC744 \uB9CC\uB098\uB7EC
      \uC654\uAD6C\uB098?"
  - id: returningGreetings_1
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4\uB0E5! \uBB58 \uAE30\uB2E4\uB838\uB354\uB77C\u2026
      \uB108\uB2E4\uB0E5!"
    - "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4\uB0E5~ \uC624\uB298\uB3C4 \uD568\uAED8\uD558\uC790\uC639!"
    - "\uC774\uC81C \uC654\uB0D0\uC639? \uAE30\uB2E4\uB9B0 \uAC74 \uC544\uB2C8\uB77C\uB2C8\uAE4C\uB0E5\u2026"
    - "\u2026\u2026\uAE30\uB2E4\uB9AC\uB2E4\uAC00\u2026 \uC7A0\uAE50 \uBA4D\uD588\uB0E5\u2026"
    - "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4\uB0E5~ \uC5BC\uB978 \uC774\uB9AC
      \uC624\uB77C\uB0E5"
    - "\uB9C8\uB140\uB2D8\uC758 \uADC0\uD658\uC744 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4\uC639."
    - "\uC774 \uBAB8\uC744 \uAE30\uB2E4\uB9AC\uAC8C \uD558\uB2E4\uB2C8! \uBC8C\uAE08\uC774\uB2E4\uB0E5~"
  - id: returningGreetings_2
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uBC14\uC05C\uAC00\uBCF4\uB2E4\uB0E5\u2026 \uB098\uB3C4 \uBC14\uC058\uB2E4\uB0E5.
      \uB0AE\uC7A0 \uC790\uC57C \uD558\uB0E5!"
    - "\uC694\uC998 \uBC14\uC05C\uAC00\uBCF4\uB2E4\uB0E5\u2026 \uC7A0\uAE50 \uC26C\uC5B4
      \uAC00\uB77C\uB0E5~"
    - "\uBC14\uC05C\uAC00 \uBCF4\uB124\uB0E5. \uBB34\uB9AC\uD558\uC9C0\uB294 \uB9D0\uB77C\uC639\u2026"
    - "\u2026\u2026\uBC14\uBE74\uB0E5? \uC2DC\uAC04\uC740 \uCC38\u2026 \uBE68\uB9AC
      \uAC00\uB0E5\u2026"
    - "\uBC14\uC05C\uAC00\uBCF4\uB2E4\uB0E5\u2026 \uADF8\uB798\uB3C4 \uB098\uB791
      \uC870\uAE08\uB9CC \uB180\uC790\uB0E5"
    - "\uB9CE\uC774 \uBC14\uC058\uC168\uB098 \uBD05\uB2C8\uB2E4\uC639. \uD3B8\uD788
      \uC26C\uC5B4 \uAC00\uC2ED\uC2DC\uC624\uB0E5."
    - "\uBC14\uC058\uB354\uB77C\uB3C4 \uC774 \uBAB8\uC744 \uC78A\uC73C\uBA74 \uC548
      \uB41C\uB2E4\uB0E5!"
  victoryGreetings:
  - id: victoryGreetings_0
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC9DC\uB9BF\uD55C \uC2B9\uBD80\uC600\uB2E4\uB0E5! \uD138\uC774 \uCB48\uBF1B
      \uC130\uB2E4\uB0E5!"
    - "\uC815\uB9D0 \uC9DC\uB9BF\uD55C \uC2B9\uBD80\uC600\uB2E4\uB0E5! \uBA4B\uC84C\uC5B4\uB0E5~"
    - "\uC81C\uBC95 \uC9DC\uB9BF\uD588\uB124\uB0E5. \uC774\uBC88\uC5D4 \uC880 \uBA4B\uC788\uC5C8\uB2E4\uC639."
    - "\u2026\u2026\uBC88\uCA4D\u2026 \uC9DC\uB9BF\uD55C \uC2B9\uBD80\uC600\uB2E4\uB0E5\u2026"
    - "\uC9DC\uB9BF\uD55C \uC2B9\uBD80\uC600\uB2E4\uB0E5~ \uC6B0\uB9AC \uB9C8\uB140
      \uCD5C\uACE0\uB2E4\uB0E5"
    - "\uCC38\uC73C\uB85C \uC9DC\uB9BF\uD55C \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4,
      \uB9C8\uB140\uB2D8."
    - "\uC774 \uBAB8\uC758 \uB9C8\uB140\uB2F5\uAC8C \uC9DC\uB9BF\uD55C \uC2B9\uB9AC\uC600\uB2E4\uB0E5!"
  - id: victoryGreetings_1
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB9C8\uBC95 \uC2E4\uB825\uC774 \uB9CE\uC774 \uB298\uC5C8\uB2E4\uB0E5! \uD0A4\uB3C4
      \uB298\uC5C8\uB0E5?"
    - "\uB9C8\uBC95 \uC2E4\uB825\uC774 \uB9CE\uC774 \uB298\uC5C8\uB2E4\uB0E5~ \uB178\uB825\uD55C
      \uBCF4\uB78C\uC774 \uC788\uAD6C\uB098\uC639!"
    - "\uB9C8\uBC95 \uC2E4\uB825\uC774 \uB298\uAE34 \uD588\uB124\uB0E5. \uCE6D\uCC2C\uC740
      \uD55C \uBC88\uBFD0\uC774\uB2E4\uC639!"
    - "\u2026\u2026\uB9C8\uBC95\uC774\u2026 \uC804\uBCF4\uB2E4 \uB2A5\uC219\uD574\uC84C\uB0E5\u2026"
    - "\uB9C8\uBC95 \uC2E4\uB825\uC774 \uC465\uC465 \uB298\uC5C8\uB2E4\uB0E5~ \uC790\uB791\uC2A4\uB7FD\uB2E4\uB0E5"
    - "\uB9C8\uBC95 \uC2E4\uB825\uC774 \uD06C\uAC8C \uD5A5\uC0C1\uB418\uC168\uC2B5\uB2C8\uB2E4\uC639.
      \uD6CC\uB96D\uD569\uB2C8\uB2E4."
    - "\uB9C8\uBC95 \uC2E4\uB825\uC774 \uB298\uC5C8\uAD6C\uB098\uB0E5! \uC774 \uBAB8\uC758
      \uAC00\uB974\uCE68 \uB355\uC774\uB2E4\uC639."
  - id: victoryGreetings_2
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB9C8\uB825\uC774 \uC5C4\uCCAD\uB098\uB2E4\uB0E5! \uC5C4\uCCAD\uB09C \uB9C8\uB140\uAC00\u2026
      \uC774\uBBF8 \uB9C8\uB140\uC600\uB0E5!"
    - "\uAC15\uB825\uD55C \uB9C8\uB825\uC774 \uB290\uAEF4\uC9C4\uB2E4\uB0E5! \uC5C4\uCCAD\uB09C
      \uB9C8\uB140\uAC00 \uB420 \uAC70\uC57C\uC639!"
    - "\uAC15\uD55C \uB9C8\uB825\uC774 \uB290\uAEF4\uC9C0\uB124\uB0E5\u2026 \uB300\uB2E8\uD55C
      \uB9C8\uB140\uAC00 \uB418\uACA0\uC5B4\uC639."
    - "\u2026\u2026\uB9C8\uB825\uC774 \uBC18\uC9DD\u2026 \uC5C4\uCCAD\uB09C \uB9C8\uB140\uAC00
      \uB418\uACA0\uB0E5\u2026"
    - "\uAC15\uB825\uD55C \uB9C8\uB825\uC774\uB2E4\uB0E5~ \uC138\uC0C1\uC5D0\uC11C
      \uC81C\uC77C \uBA4B\uC9C4 \uB9C8\uB140\uAC00 \uB418\uB77C\uB0E5\u2661"
    - "\uAC15\uB825\uD55C \uB9C8\uB825\uC774 \uB290\uAEF4\uC9D1\uB2C8\uB2E4\uC639.
      \uC704\uB300\uD55C \uB9C8\uB140\uAC00 \uB418\uC2E4 \uAC81\uB2C8\uB2E4."
    - "\uAC15\uB825\uD55C \uB9C8\uB825\uC774\uB2E4\uB0E5! \uC774 \uBAB8\uC5D0 \uAC78\uB9DE\uC740
      \uB300\uB2E8\uD55C \uB9C8\uB140\uAC00 \uB418\uB77C\uC639!"
  defeatGreetings:
  - id: defeatGreetings_0
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC544\uC27D\uB2E4\uB0E5\u2026 \uB2E4\uC74C\uC5D4 \uC774\uAE30\uB294 \uC8FC\uBB38\uC744
      \uC678\uC6B0\uC790\uB0E5!"
    - "\uC544\uC27D\uB2E4\uB0E5\u2026 \uADF8\uB798\uB3C4 \uB05D\uAE4C\uC9C0 \uC798
      \uC2F8\uC6E0\uB2E4\uC639."
    - "\uC544\uC27D\uAE34 \uD558\uB124\uB0E5\u2026 \uB108\uBB34 \uD480\uC774 \uC8FD\uC9C0\uB294
      \uB9D0\uB77C\uC639."
    - "\u2026\u2026\uC544\u2026 \uC544\uC27D\uB2E4\uB0E5\u2026"
    - "\uC544\uC27D\uB2E4\uB0E5\u2026 \uB0B4\uAC00 \uD1A0\uB2E5\uD1A0\uB2E5\uD574
      \uC8FC\uACA0\uB2E4\uB0E5"
    - "\uC544\uC26C\uC6B4 \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4\uC639. \uACE0\uAC1C\uB97C
      \uB4DC\uC2ED\uC2DC\uC624, \uB9C8\uB140\uB2D8."
    - "\uC544\uC27D\uC9C0\uB9CC \uC774 \uBAB8\uC758 \uB9C8\uB140\uAC00 \uAE30\uC8FD\uC744
      \uC218\uB294 \uC5C6\uB2E4\uB0E5!"
  - id: defeatGreetings_1
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC2B9\uB9AC\uAC00 \uC788\uC73C\uBA74 \uD328\uBC30\uB3C4 \uC788\uB2E4\uB0E5!
      \uADF8\uB2E4\uC74C\uC740 \uAC04\uC2DD\uC774\uB0E5?"
    - "\uC2B9\uB9AC\uAC00 \uC788\uC73C\uBA74 \uD328\uBC30\uB3C4 \uC788\uB294 \uBC95\uC774\uB77C\uB0E5~
      \uB2E4\uC74C\uC744 \uC900\uBE44\uD558\uC790\uC639."
    - "\uC2B9\uB9AC\uB3C4 \uD328\uBC30\uB3C4 \uC788\uB294 \uAC70\uB2E4\uB0E5. \uB2E4\uC74C\uC5D4
      \uC774\uAE30\uBA74 \uB418\uC796\uB0D0\uC639."
    - "\u2026\u2026\uC774\uAE38 \uB54C\uB3C4\u2026 \uC9C8 \uB54C\uB3C4 \uC788\uB294
      \uAC70\uB0E5\u2026"
    - "\uC2B9\uB9AC\uB3C4 \uD328\uBC30\uB3C4 \uD568\uAED8\uB2E4\uB0E5~ \uB2E4\uC74C\uC5D0\uB3C4
      \uACC1\uC5D0 \uC788\uACA0\uB2E4\uB0E5"
    - "\uC2B9\uB9AC\uAC00 \uC788\uC73C\uBA74 \uD328\uBC30\uB3C4 \uC788\uB294 \uBC95\uC785\uB2C8\uB2E4\uC639.
      \uC88B\uC740 \uACBD\uD5D8\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uD328\uBC30\uB3C4 \uC2B9\uB9AC\uB85C \uAC00\uB294 \uACFC\uC815\uC774\uB2E4\uB0E5!
      \uC774 \uBAB8\uC740 \uBBFF\uACE0 \uC788\uB2E4\uC639."
  - id: defeatGreetings_2
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB2E4\uB978 \uB9C8\uBC95\uC744 \uC368 \uBCF4\uBA74 \uC5B4\uB5BB\uB0E5? \uAC04\uC2DD
      \uB9C8\uBC95\uC740 \uC5C6\uB0E5?"
    - "\uB2E4\uB978 \uB9C8\uBC95\uC744 \uC0AC\uC6A9\uD574 \uBCF4\uB294 \uAC74 \uC5B4\uB5BB\uB0E5?
      \uC798 \uB9DE\uB294 \uB9C8\uBC95\uC744 \uCC3E\uC790\uC639~"
    - "\uB2E4\uB978 \uB9C8\uBC95\uB3C4 \uC368 \uBCF4\uB77C\uB0E5. \uB124\uAC8C \uB354
      \uB9DE\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC796\uB0D0\uC639."
    - "\u2026\u2026\uB2E4\uB978 \uB9C8\uBC95\uB3C4\u2026 \uC788\uC5C8\uC9C0\uB0E5\u2026
      \uC368 \uBCFC\uAE4C\uC639?"
    - "\uB2E4\uB978 \uB9C8\uBC95\uB3C4 \uD568\uAED8 \uACE8\uB77C \uBCF4\uC790\uB0E5~
      \uBD84\uBA85 \uC798 \uB9DE\uC744 \uAC70\uB2E4\uB0E5"
    - "\uB2E4\uB978 \uB9C8\uBC95\uC744 \uC2DC\uD5D8\uD574 \uBCF4\uC2DC\uB294 \uAC74
      \uC5B4\uB5BB\uACA0\uC2B5\uB2C8\uAE4C\uC639?"
    - "\uB2E4\uB978 \uB9C8\uBC95\uC744 \uACE8\uB77C \uBCF4\uB77C\uB0E5! \uC774 \uBAB8\uC758
      \uC548\uBAA9\uC744 \uBBFF\uC5B4\uB77C\uC639."
  - id: defeatGreetings_3
    highlight: 0
    waitForTargetClick: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB9C8\uBC95 \uAC15\uD654\uB97C \uB2E4\uC591\uD558\uAC8C \uC368 \uBCF4\uB77C\uB0E5!
      \uB2E4\uC591\uD558\uBA74 \uB9DB\uC788\u2026 \uC544\uB2C8 \uAC15\uD558\uB2E4\uB0E5!"
    - "\uB9C8\uBC95 \uAC15\uD654\uB97C \uB2E4\uC591\uD558\uAC8C \uC0AC\uC6A9\uD574
      \uBCF4\uB77C\uB0E5~ \uC0C8\uB85C\uC6B4 \uBC29\uBC95\uC774 \uBCF4\uC77C \uAC70\uB2E4\uC639!"
    - "\uAC15\uD654\uB3C4 \uB298 \uAC19\uC740 \uAC83\uB9CC \uACE0\uB974\uC9C0 \uB9D0\uB77C\uB0E5.
      \uBC14\uAFD4 \uBCF4\uBA74 \uB418\uC796\uB0D0\uC639."
    - "\u2026\u2026\uAC15\uD654 \uC870\uD569\uC744\u2026 \uBC14\uAFD4 \uBCF4\uB294
      \uAC83\uB3C4 \uC88B\uACA0\uB0E5\u2026"
    - "\uB9C8\uBC95 \uAC15\uD654\uB3C4 \uC774\uAC83\uC800\uAC83 \uACE8\uB77C \uBCF4\uC790\uB0E5~
      \uAC19\uC774 \uAC15\uD574\uC9C0\uC790\uC639"
    - "\uC5EC\uB7EC \uB9C8\uBC95 \uAC15\uD654 \uC870\uD569\uC744 \uC2DC\uB3C4\uD574
      \uBCF4\uC2DC\uAE38 \uAD8C\uD569\uB2C8\uB2E4\uC639."
    - "\uAC15\uD654 \uC870\uD569\uC744 \uB2E4\uC591\uD558\uAC8C \uC368 \uBCF4\uB77C\uB0E5!
      \uC774 \uBAB8\uC5D0\uAC8C \uC5B4\uC6B8\uB9AC\uB294 \uC804\uB7B5\uC774 \uD544\uC694\uD558\uB2E4\uC639."
  catNames:
  - "\uCFE0\uB85C \uBA00\uB140"
  - "\uCE58\uC988 \uBA00\uB140"
  - "\uBA3C\uC9C0 \uBA00\uB140"
  - "\uC790\uBC18 \uBA00\uB140"
  - "\uACE0\uB4F1\uC5B4 \uBA00\uB140"
