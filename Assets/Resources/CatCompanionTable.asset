    practice: 0
    animation: 6
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uC720\uB3C4\uD0C4\uB3C4 \uC624\uB798 \uB0A0\uAC70\uB098 \uD06C\uAC8C \uAEBE\uC73C\uBA74
