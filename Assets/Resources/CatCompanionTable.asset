    highlight: 0
    waitForTargetClick: 0
    animation: 11
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "{emote}\ub97c \ub204\ub978 \ucc44 \ub9c8\uc6b0\uc2a4\ub85c \ubc29\ud5a5\uc744 \uace0\ub978 \ub4a4, \ud0a4\ub97c \ub5bc\uc5b4 \uac10\uc815\ud45c\ud604\uc744 \ubcf4\ub0b4 \ubcf4\ub77c\ub0e5! \u2026\uc5b4, \ub0b4\uac00 \ub204\ub974\ub294 \uac74 \uc544\ub2c8\uc9c0\ub0e5?"
    - "{emote}\ub97c \ub204\ub978 \ucc44 \ub9c8\uc6b0\uc2a4\ub85c \ubc29\ud5a5\uc744 \uace0\ub978 \ub4a4, \ud0a4\ub97c \ub5bc\uc5b4 \uac10\uc815\ud45c\ud604\uc744 \ubcf4\ub0b4 \ubcf4\ub77c\ub0e5~ \ucc9c\ucc9c\ud788 \ud574\ub3c4 \uad1c\ucc2e\ub2e4\uc639!"
    - "{emote}\ub97c \ub204\ub978 \ucc44 \ub9c8\uc6b0\uc2a4\ub85c \ubc29\ud5a5\uc744 \uace0\ub978 \ub4a4, \ud0a4\ub97c \ub5bc\uc5b4 \uac10\uc815\ud45c\ud604\uc744 \ubcf4\ub0b4 \ubcf4\ub77c\ub0e5. \ub124\uac00 \ud560 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub824 \uc8fc\ub294 \uac74 \ud2b9\ubcc4\ud788\ub2e4\uc639!"
    - "\u2026\u2026\uc5b4\ub514\uae4c\uc9c0 \ud588\ub354\ub77c\ub0e5\u2026 {emote}\ub97c \ub204\ub978 \ucc44 \ub9c8\uc6b0\uc2a4\ub85c \ubc29\ud5a5\uc744 \uace0\ub978 \ub4a4, \ud0a4\ub97c \ub5bc\uc5b4 \uac10\uc815\ud45c\ud604\uc744 \ubcf4\ub0b4 \ubcf4\ub77c\ub0e5\u2026"
    - "{emote}\ub97c \ub204\ub978 \ucc44 \ub9c8\uc6b0\uc2a4\ub85c \ubc29\ud5a5\uc744 \uace0\ub978 \ub4a4, \ud0a4\ub97c \ub5bc\uc5b4 \uac10\uc815\ud45c\ud604\uc744 \ubcf4\ub0b4 \ubcf4\ub77c\ub0e5\u2661 \uc606\uc5d0\uc11c \uc751\uc6d0\ud558\uaca0\ub2e4\ub0e5~"
