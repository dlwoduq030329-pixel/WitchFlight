%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 271d0c6264084a7c9be196f9cdbfbeb7, type: 3}
  m_Name: CatCompanionTable
  m_EditorClassIdentifier: 
  catPrefab: {fileID: 2466759643076185548, guid: 7f9096ba70eb4764c8fb1b00535460c2, type: 3}
  paperAirplanePrefab: {fileID: 6017417974894778097, guid: 810e7f1c1002ac44c9a41caab9101ec2, type: 3}
  tutorialPrefab: {fileID: 4614782080702164151, guid: 19c7c37a63078d548abc10d298ce5085, type: 3}
  useCatForSummon: 1
  greetingSeconds: 3
  greetingFadeSeconds: 0.35
  returningGreetings:
  - id: returningGreetings_0
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC5B4? \uB108 \uC5B4\uB514\uC11C \uBD24\uB2E4\uB0E5!\n\uC5B4\uC11C \uC624\uB77C\uB0E5~"
    - "\uCA5D\uCA5D\u2026 \uC654\uB0D0\uB0E5? \n\uB124 \uAC04\uC2DD\uB3C4 \uB0A8\uAE30\uB824
      \uD588\uB294\uB370\u2026 \n\uBD09\uC9C0\uB9CC \uB0A8\uC558\uB2E4\uC639."
    - "\uC654\uB0D0\uC639. \n\uC606\uC790\uB9AC \uBE44\uC6CC \uB454 \uAC74 \uADF8\uB0E5\u2026
      \n\uB2E4\uB978 \uC560\uAC00 \uC549\uC744\uAE4C \uBD10\uB2E4\uB0E5."
    - "\uD558\uC554\u2026 \uAFC8\uC5D0\uC11C \uB124\uAC00 \uC654\uB294\uB370\u2026
      \n\uC544\uC9C1 \uAFC8\uC778\uAC00\uC639? \uBCFC \uC880 \uAF2C\uC9D1\uC5B4\uB77C\uB0E5\u2026"
    - "\uC654\uAD6C\uB098\uB0E5! \n\uC5BC\uAD74 \uAC00\uAE4C\uC774 \uBCF4\uC5EC \uC918\uB77C\uB0E5.
      \n\uB9CE\uC774 \uBCF4\uACE0 \uC2F6\uC5C8\uB2E4\uB0E5."
    - "\uC5B4\uC11C \uC624\uC2ED\uC2DC\uC624, \uB9C8\uB140\uB2D8. \n\uD3B8\uD788
      \uC26C\uC2E4 \uC218 \uC788\uB3C4\uB85D \uACC1\uC744 \uC9C0\uD0A4\uACA0\uC2B5\uB2C8\uB2E4\uC639."
    - "\uC654\uAD6C\uB098\uC639! \n\uC774\uBAB8\uC5D0\uAC8C \uC778\uC0AC\uB97C \uC62C\uB9AC\uB77C\uB0E5!!\n\uC624\uB298\uB3C4
      \uC608\uC058\uC9C0 \uC54A\uB290\uB0D0\uC639?"
  - id: returningGreetings_1
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4\uB0E5! \n\uB204\uAD6C\uB97C\u2026
      \uC544, \uB108\uB2E4\uC639! \n\uC0DD\uAC01\uBCF4\uB2E4 \uBE68\uB9AC \uB5A0\uC62C\uB790\uB2E4\uB0E5!"
    - "\uC6B0\uBB3C\uC6B0\uBB3C\u2026 \uAE30\uB2E4\uB9AC\uBA70 \uD55C \uC785\uC529
      \uBA39\uC5C8\uB354\uB2C8 \uADF8\uB987\uC774 \uBE44\uC5C8\uB2E4\uB0E5. \n\uAE30\uB2E4\uB9BC\uC740
      \uBC30\uACE0\uD504\uB2E4\uC639."
    - "\uB2A6\uC5C8\uB124\uC639. \n\uBB38 \uCABD\uC744 \uBCF4\uACE0 \uC788\uB358
      \uAC74\u2026 \uBC14\uB78C\uC774 \uB4E4\uC5B4\uC640\uC11C\uB2E4\uB0E5."
    - "\uAE30\uB2E4\uB9AC\uB2E4 \uC7A0\uAE50 \uC878\uC558\uB2E4\uB0E5\u2026 \n\uAFC8\uC5D0\uC11C\uB3C4
      \uAE30\uB2E4\uB838\uB294\uB370\u2026 \n\uB450 \uBC88 \uAE30\uB2E4\uB9B0 \uAC70\uB124\uC639\u2026"
    - "\uC5EC\uAE30\uB2E4\uB0E5, \uC5EC\uAE30!\n \uC5BC\uB978 \uC606\uC5D0 \uC640\uB77C\uC639.
      \n\uBD99\uC5B4 \uC788\uACE0 \uC2F6\uC5B4\uC11C \uAE30\uB2E4\uB838\uB2E4\uB0E5."
    - "\uB3CC\uC544\uC624\uC168\uAD70\uC694, \uB9C8\uB140\uB2D8. \n\uD544\uC694\uD55C
      \uC77C\uC774 \uC788\uC73C\uC2DC\uBA74 \uB9D0\uC500\uD574 \uC8FC\uC2ED\uC2DC\uC624\uC639."
    - "\uC774 \uBAB8\uC744 \uAE30\uB2E4\uB9AC\uAC8C \uD558\uB2E4\uB2C8! \n\uD55C\uBC88\uB9CC
      \uBD10\uC8FC\uACA0\uB2E4\uB0E5!. \n\uC870\uAE08\uB9CC \uB354 \uAC00\uAE4C\uC774
      \uC624\uB77C\uC639."
  - id: returningGreetings_2
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uBC14\uBE74\uB0D0\uC639? \n\uB098\uB3C4 \uACF5\uBD80\uD558\uB290\uB77C \uBC14\uBE74\uB2E4\uC639~\n1+1\uC740
      \uBC1C\uAC00\uB77D 2\uAC1C\uB2E4\uC639!"
    - "\uBC14\uBE74\uB0D0\uC639? \n\uC77C\uB2E8 \uC549\uC544\uC11C \uBA39\uC5B4\uB77C\uC639.
      \n\uC26C\uB294 \uAE40\uC5D0 \uB0B4 \uADF8\uB987\uB3C4 \uC880 \uCC44\uC6CC \uC8FC\uACE0\uB0E5."
    - "\uBC14\uBE74\uB098 \uBCF4\uB124\uC639. \n\uBB34\uB9AC\uD558\uC9C0 \uB9D0\uB77C\uB0E5.
      \n\uB124\uAC00 \uC544\uD504\uBA74\u2026 \uC870\uC6A9\uD574\uC11C \uC2EB\uB2E4\uC639."
    - "\uBC14\uBE74\uAD6C\uB098\uB0E5\u2026 \n\uB09C \uB0AE\uC7A0 \uD55C \uBC88 \uC7A4\uB294\uB370\u2026
      \n\uC5B4, \uBC16\uC774 \uBA87 \uBC88 \uC5B4\uB450\uC6CC\uC84C\uC9C0\uC639\u2026"
    - "\uBC14\uBE74\uC5B4\uB3C4 \uC640 \uC92C\uB124\uB0E5! \n\uC7A0\uAE50\uB9CC \uB098\uB791
      \uBD99\uC5B4 \uC26C\uC5C8\uB2E4 \uAC00\uB77C\uC639."
    - "\uBC14\uC05C \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uC168\uAD70\uC694, \uB9C8\uB140\uB2D8.
      \n\uC7A0\uC2DC \uC5B4\uAE68\uB97C \uD3B4\uACE0 \uC26C\uC2DC\uC9C0\uC694\uC639."
    - "\uBC14\uC05C \uAC74 \uC54C\uACA0\uB2E4\uC639. \n\uADF8\uB798\uB3C4 \uC774
      \uBAB8 \uC0DD\uAC01\uD560 \uC2DC\uAC04\uC740 \uB0A8\uACA8 \uB46C\uB77C\uB0E5!"
  victoryGreetings:
  - id: victoryGreetings_0
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC774\uACBC\uB2E4\uB0E5! \uB0B4\uAC00 \uC228\uC744 \uAF2D \uCC38\uC544\uC11C\u2026
      \n\uC5B4, \uADF8\uAC74 \uC0C1\uAD00\uC5C6\uB098\uC639? \n\uC544\uBB34\uD2BC
      \uC774\uACBC\uB2E4\uB0E5!"
    - "\uCA5D\u2026 \uC774\uACBC\uB2E4\uB0E5! \n\uCD95\uD558 \uAC04\uC2DD\uC740 \uB450
      \uC811\uC2DC\uB2E4\uC639. \n\uD558\uB098\uB294 \uB124\uAEBC\uB2E4\uC639~"
    - "\uC4F8\uB9CC\uD574\uC84C\uB2E4\uC639.\n\uB354 \uC798\uD574\uC9C0\uBA74 \uCE6D\uCC2C
      \uD574\uC8FC\uACA0\uB2E4\uC639"
    - "\uC774\uACBC\uB2E4\uB0E5\u2026 \n\uAFC8\uC5D0\uC11C\uB3C4 \uC774\uACBC\uB294\uB370\u2026
      \n\uAFC8\uBCF4\uB2E4 \uB124\uAC00 \uB354 \uC798\uD588\uB124\uC639\u2026"
    - "\uC774\uACBC\uB2E4\uB0E5! \n\uB098\uBD80\uD130 \uBD10\uB77C\uC639. \n\uC81C\uC77C
      \uBA3C\uC800 \uC798\uD588\uB2E4\uACE0 \uB9D0\uD574 \uC8FC\uACE0 \uC2F6\uC5C8\uB2E4\uB0E5!"
    - "\uD6CC\uB96D\uD55C \uC2B9\uB9AC\uC600\uC2B5\uB2C8\uB2E4, \uB9C8\uB140\uB2D8.
      \n\uB05D\uAE4C\uC9C0 \uCE68\uCC29\uD558\uAC8C \uC2F8\uC6B0\uC168\uC2B5\uB2C8\uB2E4\uC639."
    - "\uBA4B\uC9C4 \uC2B9\uB9AC\uB2E4\uC639! \n\uC774 \uBAB8\uC758 \uB9C8\uB140
      \uB2F5\uB2E4\uB0E5!!!! \n\uB0D0~\uD558\uD558\uD558\uD558!!!"
  - id: victoryGreetings_1
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB9C8\uBC95 \uC2E4\uB825\uC774 \uB298\uC5C8\uB2E4\uB0E5! \n\uC2E4\uB825\uC740
      \uC5B4\uB514\uC5D0 \uB123\uC5B4 \uB450\uB294\uAC70\uB0D0\uC639?"
    - "\uC2E4\uB825\uC774 \uC465 \uB298\uC5C8\uB2E4\uB0E5. \n\uB4E0\uB4E0\uD558\uAC8C
      \uC798 \uC2F8\uC6E0\uC73C\uB2C8 \uB4E0\uB4E0\uD558\uAC8C \uBA39\uC5B4\uC57C\uC9C0\uC639."
    - "\uC804\uBCF4\uB2E4 \uC798\uD558\uB124\uC639. \n\uACC4\uC18D \uBCF4\uACE0 \uC788\uC5C8\uC73C\uB2C8\uAE4C
      \uC548\uB2E4\uB0E5. \n\uCE6D\uCC2C\uC740 \uD55C \uBC88\uBFD0\uC774\uB2E4\uC639."
    - "\uB9C8\uBC95\uC774\u2026 \uC804\uBCF4\uB2E4 \uC798 \uB098\uAC04\uB2E4\uB0E5.
      \n\uB098\uB3C4 \uAFC8\uC5D0\uC11C \uC5F0\uC2B5\uD588\uB294\uB370\u2026 \uAE68\uB2C8
      \uC78A\uC5C8\uB2E4\uC639\u2026"
    - "\uC5F0\uC2B5\uD55C \uBCF4\uB78C\uC774 \uC788\uB2E4\uB0E5! \n\uB0B4\uAC00 \uB2E4
      \uBFCC\uB4EF\uD574\uC11C \uAF2C\uB9AC\uAC00 \uC548 \uBA48\uCD98\uB2E4\uC639."
    - "\uC2E4\uB825\uC774 \uD55C\uCE35 \uAE4A\uC5B4\uC9C0\uC168\uC2B5\uB2C8\uB2E4\uC639.
      \n\uAFB8\uC900\uD788 \uC5F0\uC2B5\uD558\uC2E0 \uACB0\uACFC\uC785\uB2C8\uB2E4,
      \uB9C8\uB140\uB2D8."
    - "\uB9CE\uC774 \uB298\uC5C8\uAD6C\uB098\uC639! \n\uC774 \uBAB8\uC774 \uC54C\uC544\uBCF8
      \uB9C8\uB140\uB2E4\uB0E5. \n\uC5B4\uAE68\uB97C \uD3B4\uB3C4 \uC88B\uB2E4\uC639."
  - id: victoryGreetings_2
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB9C8\uB825\uC774 \uB300\uB2E8\uD558\uB2E4\uB0E5! \n\uB108 \uC0AC\uC2E4 \uB9C8\uB140\uC600\uB0D0\uC639??!"
    - "\uB9C8\uB825\uC774 \uC544\uC8FC \uB4E0\uB4E0\uD558\uB2E4\uB0E5. \n\uB09C \uBC30\uB9CC
      \uB4E0\uB4E0\uD55C\uB370\u2026 \n\uCA5D, \uC5ED\uD560\uC774 \uB2E4\uB974\uB2E4\uC639."
    - "\uB9C8\uB825\uC774 \uC81C\uBC95\uC774\uB124\uC639. \n\uB2E4\uC74C\uC5D0\uB3C4
      \uBCF4\uC5EC \uC918\uB77C\uB0E5."
    - "\uB9C8\uBC95\uC774 \uBC88\uCA4D\uD588\uB2E4\uB0E5\u2026 \n\uB208 \uAC10\uC544\uB3C4
      \uBCF4\uC774\uB124\uC639\u2026 \n\uB208\uC744 \uC548 \uAC10\uC558\uB098\uB0E5\u2026"
    - "\uB124 \uB9C8\uBC95, \uC815\uB9D0 \uBA4B\uC84C\uB2E4\uB0E5! \n\uB10C \uCD5C\uACE0\uC758
      \uB9C8\uB140\uB2E4\uC639!!!"
    - "\uC778\uC0C1\uC801\uC778 \uB9C8\uB825\uC774\uC5C8\uC2B5\uB2C8\uB2E4\uC639.
      \n\uB9C8\uB140\uB2D8\uC758 \uB2E4\uC74C \uD65C\uC57D\uB3C4 \uAE30\uB300\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uBC18\uC9DD\uC774\uB294 \uB9C8\uBC95\uC774\uC5C8\uAD6C\uB098\uC639! \n\uC774
      \uBAB8\uC758 \uC544\uB984\uB2E4\uC6C0 \uB2E4\uC74C\uC73C\uB85C \uB208\uC5D0
      \uB744\uC5C8\uB2E4\uB0E5.\n\uB0D0~\uD558\uD558\uD558\uD558\uD558!!"
  defeatGreetings:
  - id: defeatGreetings_0
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC84C\uB0D0\uC639? \n\uADF8\uB7FC \uB2E4\uC74C\uC5D4 \uC774\uAE30\uBA74 \uB41C\uB2E4\uB0E5! "
    - "\uC544\uC27D\uB2E4\uB0E5\u2026 \n\uC77C\uB2E8 \uB530\uB73B\uD55C \uAC70 \uBA39\uACE0
      \uC26C\uC5B4\uB77C\uC639. \n\uB0B4 \uAC04\uC2DD\uB3C4 \uD55C \uC785 \uB098\uB220
      \uC8FC\uACA0\uB2E4\uB0E5."
    - "\uD480 \uC8FD\uC5B4\uC788\uAE30\uB294,\n\uBCF4\uAE30\uC2EB\uB2E4\uB0E5!"
    - "\uC84C\uAD6C\uB098\uB0E5\u2026 \n\uAFC8\uC774\uBA74 \uC88B\uACA0\uB294\uB370\u2026
      \n\uADF8\uB798\uB3C4 \uB124\uAC00 \uB3CC\uC544\uC640\uC11C \uB2E4\uD589\uC774\uB2E4\uC639\u2026"
    - "\uC18D\uC0C1\uD588\uC9C0\uB0E5? \n\uC774\uB9AC \uC624\uB77C\uC639. \n\uC798
      \uC2F8\uC6E0\uB2E4\uACE0 \uAF2D \uBD99\uC5B4\uC11C \uB9D0\uD574 \uC8FC\uACA0\uB2E4\uB0E5."
    - "\uC544\uC26C\uC6B4 \uC2B9\uBD80\uC600\uC2B5\uB2C8\uB2E4\uC639. \n\uC560\uC4F0\uC168\uC2B5\uB2C8\uB2E4,
      \uB9C8\uB140\uB2D8. \n\uC7A0\uC2DC \uC228\uC744 \uACE0\uB974\uC2DC\uC9C0\uC694."
    - "\uACE0\uAC1C\uB97C \uB4E4\uB77C\uC639! \n\uD55C \uBC88 \uC84C\uB2E4\uACE0
      \uC774 \uBAB8\uC758 \uB9C8\uB140\uAC00 \uBE5B\uC744 \uC783\uC9C4 \uC54A\uB294\uB2E4\uB0E5."
  - id: defeatGreetings_1
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC774\uAE38 \uB54C\uB3C4 \uC9C0\uB294 \uB54C\uB3C4 \uC788\uB2E4\uB0E5! \n\uC9C0\uAE08\uC740
      \uC9C0\uB294 \uB54C\uC600\uACE0\u2026 \uB2E4\uC74C\uC740 \uB2EC\uB77C\uC9C8
      \uC218 \uC788\uB2E4\uC639!"
    - "\uC798\uB418\uB294 \uB0A0\uB3C4 \uC548 \uB418\uB294 \uB0A0\uB3C4 \uC788\uB2E4\uB0E5.
      \n\uCA5D\u2026 \uBC25\uC740 \uC5B4\uB290 \uB0A0\uC774\uB098 \uCC59\uACA8 \uBA39\uC5B4\uB77C\uC639."
    - "\uC9C8 \uB54C\uB3C4 \uC788\uB294 \uAC70\uB2E4\uC639. \n\uB2E4\uC74C\uC5D0
      \uC774\uAE30\uBA74 \uB418\uC9C0\uB0E5. "
    - "\uC774\uAE30\uACE0 \uC9C0\uACE0\u2026 \uB458 \uB2E4 \uC788\uB294 \uAC70\uB2E4\uB0E5.\n\uC7A0\uC740
      \uB9E4\uBC88 \uC624\uB294\uB370\u2026 \uC2B9\uB9AC\uB294 \uB2E4\uC74C\uC5D0
      \uC62C \uC218\uB3C4\uC639\u2026"
    - "\uC774\uACA8\uB3C4 \uC838\uB3C4 \uB09C \uB124 \uD3B8\uC774\uB2E4\uB0E5!!\n\uB610
      \uAC19\uC774 \uAC00 \uC8FC\uACA0\uB2E4\uB0E5~"
    - "\uC2B9\uD328\uB294 \uB298 \uBC14\uB00C\uB294 \uBC95\uC785\uB2C8\uB2E4\uC639.
      \n\uC774\uBC88 \uACBD\uD5D8\uC774 \uB2E4\uC74C \uD310\uB2E8\uC5D0 \uB3C4\uC6C0\uC774
      \uB420 \uAC81\uB2C8\uB2E4."
    - "\uC774 \uBAB8\uB3C4 \uB298 \uB73B\uB300\uB85C \uB418\uB294 \uAC74 \uC544\uB2C8\uB2E4\uC639.
      \n\uADF8\uB798\uB3C4 \uC544\uB984\uB2E4\uC6C0\uC740 \uC601\uC6D0\uD55C \uBC95\uC774\uB2E4\uB0E5!"
  - id: defeatGreetings_2
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uB2E4\uB978 \uB9C8\uBC95\uB3C4 \uC368 \uBCF4\uB77C\uB0E5! \n\uC9C0\uD321\uC774\uB294
      \uD558\uB098\uC778\uB370 \uB9C8\uBC95\uC740 \uB9CE\uB2E4\uC639. \n\uC2E0\uAE30\uD558\uB2E4\uB0E5!"
    - "\uB2E4\uB978 \uB9C8\uBC95\uB3C4 \uACE8\uB77C \uBCF4\uB77C\uB0E5. \n\uB298
      \uAC19\uC740 \uAC83\uB9CC \uBA39\uC73C\uBA74\u2026 \uC544\uB2C8, \uC4F0\uBA74
      \uC544\uC27D\uC9C0\uC639."
    - "\uB2E4\uB978 \uB9C8\uBC95\uB3C4 \uC368 \uBD10\uB77C\uC639. \n\uB124\uAC8C
      \uB9DE\uB294 \uAC8C \uC788\uC744 \uAC70\uB2E4\uB0E5. \n\uAC19\uC774 \uBD10\uC8FC\uACA0\uB2E4\uB0E5."
    - "\uB2E4\uB978 \uB9C8\uBC95\uB3C4\u2026 \uC368 \uBCF4\uB77C\uB0E5. \n\uC7A0\uC790\uAE30
      \uB9C8\uBC95\uC740 \uC5C6\uB0D0\uC639...?"
    - "\uB2E4\uB978 \uB9C8\uBC95\uB3C4 \uB098\uB791 \uACE8\uB77C \uBCF4\uC790\uB0E5.
      \n\uB124 \uC190\uC5D0 \uC798 \uB9DE\uB294 \uAC78 \uCC3E\uC744 \uB54C\uAE4C\uC9C0
      \uC606\uC5D0 \uC788\uC744\uAC8C\uC639."
    - "\uB2E4\uB978 \uB9C8\uBC95\uC744 \uC2DC\uD5D8\uD574 \uBCF4\uC2DC\uB294 \uAC74
      \uC5B4\uB5BB\uACA0\uC2B5\uB2C8\uAE4C\uC639?\n\uC190\uC5D0 \uB9DE\uB294 \uC870\uD569\uC744
      \uCC3E\uC544\uBCF4\uC2DC\uC9C0\uC694."
    - "\uB2E4\uB978 \uB9C8\uBC95\uC744 \uACE8\uB77C \uBCF4\uB77C\uC639!\n\uBBF8\uB140\uB294
      \uC120\uD0DD\uC9C0\uAC00 \uB9CE\uC740 \uBC95\uC774\uB2E4\uB0E5!"
  - id: defeatGreetings_3
    highlight: 0
    waitForTargetClick: 0
    practice: 0
    animation: 1
    dreamyPauseSeconds: 0
    personalityLines:
    - "\uC5C4\uCCAD\uB09C \uD2B9\uC804\uB4E4\uC774 \uB9CE\uB2E4\uB0E5!!\n\uC0AC\uC2E4...\uB098\uB3C4
      \uBABB\uC678\uC6E0\uB2E4\uB0E5~"
    - "\uB9C8\uBC95 \uAC15\uD654\uB3C4 \uB2E4\uB974\uAC8C \uACE8\uB77C \uBCF4\uB77C\uB0E5.
      \n\uC798 \uC5B4\uC6B8\uB9AC\uB294 \uC870\uD569\uC740 \uB9DB\uBD80\uD130\u2026
      \uC544, \uD798\uBD80\uD130 \uB2E4\uB974\uB2E4\uC639."
    - "\uD2B9\uC804\uB3C4 \uB298 \uAC19\uC740 \uAC83\uB9CC \uACE0\uB974\uC9C0 \uB9C8\uB77C\uC639.
      \n\uB2E4\uB978 \uC870\uD569\uC774 \uB354 \uC798 \uB9DE\uC744 \uC218\uB3C4 \uC788\uC796\uB0D0\uB0E5."
    - "\uD2B9\uC804 \uC870\uD569\uC744\u2026 \uBC14\uAFD4 \uBCF4\uB77C\uB0E5. \n\uC544\uAE4C
      \uACE0\uB978 \uAC8C \uBB50\uC600\uB354\uB77C\uC639\u2026 \uC798 \uBCF4\uACE0
      \uACE8\uB77C\uB77C\uB0E5\u2026"
    - "\uAC15\uD654 \uC870\uD569\uB3C4 \uAC19\uC774 \uBC14\uAFD4 \uBCF4\uC790\uB0E5!
      \n\uB124\uAC00 \uB2E4\uC2DC \uC2E0\uB098\uAC8C \uC2F8\uC6B0\uBA74 \uC88B\uACA0\uB2E4\uC639."
    - "\uC5EC\uB7EC \uB9C8\uBC95 \uAC15\uD654 \uC870\uD569\uC744 \uC2DC\uB3C4\uD574
      \uBCF4\uC2ED\uC2DC\uB77C\uB0E5. \n\uC804\uD22C \uBC29\uC2DD\uC5D0 \uB9DE\uB294
      \uC120\uD0DD\uC774 \uC788\uC744 \uAC81\uB2C8\uB2E4."
    - "\uD2B9\uC804 \uC870\uD569\uB3C4 \uB124\uAC8C \uC5B4\uC6B8\uB9AC\uAC8C \uACE0\uB974\uB77C\uC639!
      \n\uC774 \uBAB8\uC5D0\uAC8C \uC5B4\uC6B8\uB9AC\uB294 \uC7A5\uC2DD\uCC98\uB7FC
      \uB9D0\uC774\uB2E4\uB0E5."
