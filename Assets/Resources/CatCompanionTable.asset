    practice: 0
    animation: 8
    dreamyPauseSeconds: 0.8
    personalityLines:
    - "\uB85D\uC628 \uB9C8\uBC95\uC740 \uCD08\uB85D \uC870\uC900\uC810\uC77C \uB54C
