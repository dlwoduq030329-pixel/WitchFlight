+            BattleManager.Instance != null && BattleManager.Instance.IsGameplayActive)
+            LockFailureSequence++;
+        bool wasFullyLocked = IsFullyLocked;
+        LockTargetId = default;
+        LockProgress = 0f;
+        IsFullyLocked = false;
