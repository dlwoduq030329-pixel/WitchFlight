+        FreezeCompletedSnapshot(localSnapshot);
+        UpdateTeamProfileMotion();
+        FreezeCompletedSnapshot(opponentSnapshot);
+        foreach (PortraitSnapshot snapshot in teamSnapshots) FreezeCompletedSnapshot(snapshot);
