+        if (table.useCatForSummon) foreach (var projectile in MagicProjectile.ActiveProjectiles)
+            if (projectile != null && projectile.IsLiveSummon && projectile.Runner == owner.Runner && projectile.Shooter == owner.ParticipantRef)
+            { summoned = true; break; }
