-        if (parryPressed || (pressed && CurrentMagicSlot == 3))
-        {
-            float cost = magicStatTable != null ? magicStatTable.parryApCost : 16f;
-            if (!TimerIsActive(ParryCooldown) && NowAp < Mathf.Max(0f, cost)) return true;
