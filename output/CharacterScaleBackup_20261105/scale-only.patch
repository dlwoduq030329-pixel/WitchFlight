-            ? brakeSpeed * (1f + CommonAmount(PerkId.BrakingRune)) : stageTransitionSpeed * GetMovementMultiplier() *
-                (Mathf.Abs(SpeedStage) == 1 && Mathf.Abs(Speed) < flightMaxSpeed / 3f ? 1f + CommonAmount(PerkId.FirstWind) : 1f);
